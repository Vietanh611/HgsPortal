{
  "config": {
    "default": true,
    "MD013": false,
    "MD024": { "siblings_only": true },
    "MD033": { "allowed_elements": [] },
    "MD034": true,
    "MD029": false
  },
  "globs": ["Docs/**/*.md", ".ai/docs/**/*.md", ".ai/agents/**/*.md", ".ai/context/**/*.md", ".ai/README.md"],
  "ignores": ["node_modules/**", ".git/**", ".gitnexus/**", ".ai/skill-library/**", ".ai/skills/**"]
}
