@page "/display/DAD"
@attribute [AllowAnonymous]
@layout EmptyLayout
@rendermode @(new InteractiveWebAssemblyRenderMode(prerender: false))
@using Hgs.Share.Dtos
@using Hgs.Share.Responses.ApiResponses
@using Hgs.Share.Responses.CoreAssets
@using Microsoft.AspNetCore.Authorization
@using Microsoft.AspNetCore.Components.Authorization
@using WebApp.Client.Services
@using WebApp.Client.Services.Network
@inject ApiClient ApiClient
@inject NavigationManager Navigation
@inject IJSRuntime JS
@inject KioskDeviceConfigService KioskConfig
@inject AuthenticationStateProvider AuthState
@implements IAsyncDisposable

<link href="css/baggage-display.css" rel="stylesheet" />

<div class="container-fluid display-page">
    @if (isChecking || isLoading)
    {
        <div class="text-center py-5">
            <div class="spinner-border text-primary" role="status">
                <span class="visually-hidden">Loading...</span>
            </div>
        </div>
    }
    else if (!isAuthenticated && kioskConfig == null)
    {
        <div class="kiosk-setup-screen">
            @if (deviceNotice != null)
            {
                <div class="alert alert-warning" role="alert">
                    @deviceNotice
                </div>
            }
            <KioskDeviceSetup Config="@kioskConfig" OnChanged="HandleConfigChanged" />
            <p class="text-muted mt-3 mb-0">
                Nhập mã ghép phía trên để kích hoạt màn hình và bắt đầu hiển thị.
            </p>
        </div>
    }
    else if (deviceNotice != null)
    {
        <div class="alert alert-warning" role="alert">
            @deviceNotice
        </div>
    }
    else if (errorMessage != null)
    {
        <div class="alert alert-danger" role="alert">
            @errorMessage
        </div>
    }
    else if (images?.Count > 0 || baggageData?.Count > 0)
    {
        <div>
            @if (!isLoading)
            {                
                <Carousel ShowIndicators="false"
                          ShowPreviousNextControls="false"
                          Crossfade="true"
                          Interval="5000"
                          Autoplay="CarouselAutoPlay.StartOnPageLoad">

                    @if (baggageData != null && baggageData.Any())
                    {
                        <!-- CÓ DATA → CHỈ HIỂN THỊ DATA -->
                        <CarouselItem class="active">
                            <div class="arrival-item">
                                <div class="arrival-logo">
                                    <img src="@($"{Navigation.BaseUri}assets/hgs/new%20logo/logo.png")"
                                         alt="HGS" />
                                </div>

                                <div class="card">
                                    <div class="card-header current-flights-header">
                                        <h5 class="mb-0 current-flights-title">NOW HANDLING</h5>
                                    </div>

                                    <div class="card-body">
                                        <div class="table-responsive">
                                            <table class="arrival-display-table">
                                                <thead>
                                                    <tr>
                                                        <th>Carrier</th>
                                                        <th>Flight</th>
                                                        <th>Depart From</th>
                                                        <th>Belt No.</th>
                                                    </tr>
                                                </thead>

                                                <tbody>
                                                    @foreach (var baggage in baggageData)
                                                    {
                                                        <tr>
                                                            <td>
                                                                <img src="@($"{Navigation.BaseUri}{baggage.Path}")"
                                                                     alt="Logo"
                                                                     class="img-fluid"
                                                                     style="max-height: 50px;" />
                                                            </td>

                                                            <td>@baggage.FlightNo</td>

                                                            <td>
                                                                <div class="route-city">
                                                                    <div class="route">@baggage.Route</div>
                                                                    <div class="city">@baggage.NameCity</div>
                                                                </div>
                                                            </td>

                                                            <td>
                                                                @if (!string.IsNullOrEmpty(baggage.Belt))
                                                                {
                                                                    <span>@baggage.Belt</span>
                                                                }
                                                                else
                                                                {
                                                                    <span class="text-muted">N/A</span>
                                                                }
                                                            </td>
                                                        </tr>
                                                    }
                                                </tbody>
                                            </table>
                                        </div>
                                    </div>
                                </div>
                            </div>
                        </CarouselItem>
                    }
                    else if (images != null && images.Any())
                    {
                        <!-- KHÔNG CÓ DATA → CHỈ HIỂN THỊ ẢNH -->
                        var isFirstItem = true;

                        @foreach (var image in images)
                        {
                            <CarouselItem class="@(isFirstItem ? "active" : "")">
                                <div class="d-flex justify-content-center align-items-center w-100">
                                    <img src="@image.StoragePath"
                                         class="display-image"
                                         alt="@image.FileName" />
                                </div>
                            </CarouselItem>

                            isFirstItem = false;
                        }
                    }

                </Carousel>
            }

        </div>
    }
    else
    {
        <div class="text-center py-5 text-muted">
            Chưa có dữ liệu hiển thị.
        </div>
    }
    <footer class="display-footer">
        CAN'T FIND YOUR BAGGAGE? Please contact our Lost & Found staff
    </footer>
</div>

@code {
    private List<BaggageArrivalDisplayDto>? baggageData;
    private List<CoreAssetsGetAllResponse>? images;
    private KioskDeviceConfig? kioskConfig;
    private bool isChecking = true;
    private bool isLoading = true;
    private string? errorMessage;
    private string? deviceNotice;
    private int carouselKey = 0;
    private PeriodicTimer? timer;
    private CancellationTokenSource? cts;
    private bool isAuthenticated;
    protected override async Task OnInitializedAsync()
    {
        cts = new CancellationTokenSource();
        kioskConfig = await KioskConfig.GetAsync();
        var authState = await AuthState.GetAuthenticationStateAsync();
        isAuthenticated = authState.User.Identity?.IsAuthenticated == true;
        isChecking = false;
        if (isAuthenticated || kioskConfig != null)
        {
            await LoadData();
        }
        isLoading = false;
        timer = new PeriodicTimer(TimeSpan.FromMinutes(1));

        _ = PollAsync(cts.Token);
    }
    private async Task PollAsync(CancellationToken token)
    {
        try
        {
            while (await timer!.WaitForNextTickAsync(token))
            {
                if (isAuthenticated || kioskConfig != null)
                {
                    await InvokeAsync(LoadData);
                }
            }
        }
        catch (OperationCanceledException)
        {
        }
    }
    // private IJSObjectReference? module;

    // protected override async Task OnAfterRenderAsync(bool firstRender)
    // {
    //     if (firstRender)
    //     {
    //         module = await JS.InvokeAsync<IJSObjectReference>(
    //             "import",
    //             "./Pages/display/DomesticBaggageArrivalDisplay.razor.js");

    //         await module.InvokeVoidAsync("setArrivalManifest");
    //     }
    // }

    // public async ValueTask DisposeAsync()
    // {
    //     if (module != null)
    //     {
    //         await module.DisposeAsync();
    //     }
    // }
    public ValueTask DisposeAsync()
    {
        cts?.Cancel();
        timer?.Dispose();
        cts?.Dispose();

        return ValueTask.CompletedTask;
    }

    private async Task LoadData()
    {

        errorMessage = null;

        try
        {
            var headers = kioskConfig != null
                ? new Dictionary<string, string>
                {
                    ["X-Device-Id"] = kioskConfig.DeviceId,
                    ["X-Device-Key"] = kioskConfig.DeviceKey
                }
                : null;

            var baggageResult = await ApiClient.GetSilentAsync<ApiResponse<IEnumerable<BaggageArrivalDisplayDto>>>(
                "api/display/GetDomesticBaggageArrivalDisplay", headers);

            if (baggageResult.IsUnauthorized)
            {
                if (kioskConfig != null)
                {
                    await HandleDeviceUnauthorizedAsync(baggageResult.ErrorCode);
                }
                else
                {
                    errorMessage = "Phiên đăng nhập đã hết hạn. Vui lòng đăng nhập lại.";
                }
                return;
            }

            if (baggageResult.Success && baggageResult.Data is { Success: true, Data: not null })
            {
                baggageData = baggageResult.Data.Data.ToList();
            }

            var assetsResult = await ApiClient.GetSilentAsync<ApiResponse<IEnumerable<CoreAssetsGetAllResponse>>>(
                "api/coreassets", headers);

            if (assetsResult.IsUnauthorized)
            {
                if (kioskConfig != null)
                {
                    await HandleDeviceUnauthorizedAsync(assetsResult.ErrorCode);
                }
                else
                {
                    errorMessage = "Phiên đăng nhập đã hết hạn. Vui lòng đăng nhập lại.";
                }
                return;
            }

            if (assetsResult.Success && assetsResult.Data is { Success: true, Data: not null })
            {
                images = assetsResult.Data.Data
                    .Where(a => a.Code == "ARRIVAL_DISPLAY" && a.IsActive)
                    .ToList();
            }

            deviceNotice = null;
            StateHasChanged();
        }
        catch (Exception ex)
        {
            errorMessage = $"Lỗi khi tải dữ liệu: {ex.Message}";
        }
        finally
        {
            carouselKey++;
        }
    }

    /// <summary>
    /// Xử lý khi device key bị API từ chối (401): nếu thiết bị bị tắt (DEVICE_DISABLED) thì giữ
    /// cấu hình và hiện thông báo chờ admin bật lại; nếu bị thu hồi/không còn hiệu lực thì xóa
    /// cấu hình để hiện lại màn hình ghép cặp.
    /// </summary>
    private async Task HandleDeviceUnauthorizedAsync(string? errorCode)
    {
        if (errorCode == "DEVICE_DISABLED")
        {
            deviceNotice = "Thiết bị đã bị vô hiệu hóa. Vui lòng liên hệ quản trị viên.";
            StateHasChanged();
            return;
        }

        await KioskConfig.ClearAsync();
        kioskConfig = null;
        deviceNotice = "Thiết bị đã bị thu hồi hoặc không còn hiệu lực. Vui lòng nhập mã ghép mới từ quản trị viên.";
        StateHasChanged();
    }

    private async Task HandleConfigChanged()
    {
        kioskConfig = await KioskConfig.GetAsync();
        errorMessage = null;
        if (kioskConfig == null)
        {
            deviceNotice = null;
        }
        if (isAuthenticated || kioskConfig != null)
        {
            await LoadData();
        }
        StateHasChanged();
    }

}

