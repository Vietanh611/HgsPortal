@page "/displaydevices"
@using Hgs.Share.Requests.DisplayDevices
@using Hgs.Share.Responses.DisplayDevices
@using BlazorBootstrap
@inject WebApp.Client.Services.DisplayDevicesService DisplayDevicesService

<PageTitle>Thiết bị hiển thị</PageTitle>

<div class="container">
    <div class="row">
        <div class="col-12">
            <div class="d-flex justify-content-between align-items-center mb-4">
                <h1 class="h2 mb-0">Thiết bị hiển thị</h1>
                <div class="d-flex gap-2">
                    <Button Color="ButtonColor.Secondary" Outline="true" @onclick="LoadDevices" aria-label="Làm mới danh sách thiết bị">
                        <Icon Name="IconName.ArrowClockwise" /> Làm mới
                    </Button>
                    <Button Color="ButtonColor.Primary" @onclick="ShowCreateModal">
                        <Icon Name="IconName.PlusLg" /> Thêm thiết bị
                    </Button>
                </div>
            </div>

            <Card>
                <CardBody>
                    @if (isLoading)
                    {
                        <div class="text-center py-5">
                            <Spinner Color="SpinnerColor.Primary" />
                        </div>
                    }
                    else if (errorMessage != null)
                    {
                        <HgsErrorState Message="@errorMessage" RetryClick="@LoadDevices" />
                    }
                    else if (devices != null && !devices.Any())
                    {
                        <HgsEmptyState Title="Chưa có thiết bị hiển thị"
                                       Message="Nhấn Thêm thiết bị để đăng ký thiết bị hiển thị đầu tiên."
                                       ShowAction="true"
                                       ActionText="Thêm thiết bị"
                                       ActionClick="@ShowCreateModal" />
                    }
                    else
                    {
                        <Grid TItem="DisplayDevicesGetAllResponse" Data="devices" AllowPaging="true" AllowSorting="true" Responsive="true"
                              Class="table table-hover table-bordered table-striped" PageSize="10">
                            <GridColumn TItem="DisplayDevicesGetAllResponse" HeaderText="ID" SortKeyExpression="item => item.Id">
                                @context.Id
                            </GridColumn>
                            <GridColumn TItem="DisplayDevicesGetAllResponse" HeaderText="Tên thiết bị" SortKeyExpression="item => item.DeviceName">
                                @context.DeviceName
                            </GridColumn>
                            <GridColumn TItem="DisplayDevicesGetAllResponse" HeaderText="Mã định danh" SortKeyExpression="item => item.DeviceIdentifier">
                                @context.DeviceIdentifier
                            </GridColumn>
                            <GridColumn TItem="DisplayDevicesGetAllResponse" HeaderText="Trạng thái" SortKeyExpression="item => item.Status">
                                <Badge Color="@(context.Status == "ACTIVE" ? BadgeColor.Success : BadgeColor.Secondary)">@context.Status</Badge>
                            </GridColumn>
                            <GridColumn TItem="DisplayDevicesGetAllResponse" HeaderText="Kích hoạt">
                                @if (context.IsEnabled)
                                {
                                    <Badge Color="BadgeColor.Success">Có</Badge>
                                }
                                else
                                {
                                    <Badge Color="BadgeColor.Danger">Không</Badge>
                                }
                            </GridColumn>
                            <GridColumn TItem="DisplayDevicesGetAllResponse" HeaderText="Hoạt động gần nhất" SortKeyExpression="item => item.LastSeenAt">
                                @(context.LastSeenAt?.ToString("yyyy-MM-dd HH:mm:ss") ?? "Chưa từng")
                            </GridColumn>
                        </Grid>
                    }
                </CardBody>
            </Card>
        </div>
    </div>
</div>

<Modal @ref="createModal" Title="Thêm thiết bị hiển thị mới" Size="ModalSize.Large">
    <BodyTemplate>
        <div class="row g-3">
            <div class="col-md-6">
                <label class="form-label" for="deviceName">Tên thiết bị *</label>
                <InputText id="deviceName" class="form-control" @bind-Value="newDevice.DeviceName" placeholder="Nhập tên thiết bị" />
            </div>
            <div class="col-md-6">
                <label class="form-label" for="deviceIdentifier">Mã định danh thiết bị *</label>
                <InputText id="deviceIdentifier" class="form-control" @bind-Value="newDevice.DeviceIdentifier" placeholder="Nhập mã định danh thiết bị" />
            </div>
            <div class="col-md-6">
                <label class="form-label" for="deviceStatus">Trạng thái</label>
                <InputText id="deviceStatus" class="form-control" @bind-Value="newDevice.Status" placeholder="ACTIVE" />
            </div>
            <div class="col-md-6 d-flex align-items-center">
                <div class="form-check mb-0">
                    <InputCheckbox id="deviceEnabled" class="form-check-input" @bind-Value="newDevice.IsEnabled" />
                    <label class="form-check-label" for="deviceEnabled">Kích hoạt thiết bị này</label>
                </div>
            </div>
        </div>
        @if (!string.IsNullOrEmpty(createErrorMessage))
        {
            <Alert Color="AlertColor.Danger" role="alert" class="mt-3">@createErrorMessage</Alert>
        }
    </BodyTemplate>
    <FooterTemplate>
        <Button Color="ButtonColor.Secondary" @onclick="HideCreateModal" Disabled="@isCreating">Hủy</Button>
        <Button Color="ButtonColor.Primary" @onclick="HandleCreateDevice" Disabled="@isCreating">
            @if (isCreating)
            {
                <Spinner Size="SpinnerSize.Small" />
            }
            else
            {
                <Icon Name="IconName.PlusLg" />
            }
            Tạo thiết bị
        </Button>
    </FooterTemplate>
</Modal>

@code {
    private IEnumerable<DisplayDevicesGetAllResponse>? devices;
    private bool isLoading = true;
    private string? errorMessage;
    private bool showCreateModal = false;
    private bool isCreating = false;
    private string? createErrorMessage;
    private DisplayDevicesCreateRequest newDevice = new();
    private Modal? createModal;

    protected override async Task OnInitializedAsync()
    {
        await LoadDevices();
    }

    private async Task LoadDevices()
    {
        isLoading = true;
        errorMessage = null;
        devices = null;

        try
        {
            devices = await DisplayDevicesService.GetDisplayDevicesAsync();

            if (devices == null)
            {
                errorMessage = "Không thể tải danh sách thiết bị hiển thị. Vui lòng thử lại.";
            }
        }
        catch (Exception ex)
        {
            errorMessage = $"Lỗi khi tải danh sách thiết bị hiển thị: {ex.Message}";
        }
        finally
        {
            isLoading = false;
        }
    }

    private async Task ShowCreateModal()
    {
        newDevice = new DisplayDevicesCreateRequest();
        createErrorMessage = null;
        if (createModal != null)
        {
            await createModal.ShowAsync();
        }
    }

    private async Task HideCreateModal()
    {
        if (createModal != null)
        {
            await createModal.HideAsync();
        }
    }

    private async Task HandleCreateDevice()
    {
        if (string.IsNullOrWhiteSpace(newDevice.DeviceName) || string.IsNullOrWhiteSpace(newDevice.DeviceIdentifier))
        {
            createErrorMessage = "Tên thiết bị và mã định danh là bắt buộc.";
            return;
        }

        isCreating = true;
        createErrorMessage = null;

        try
        {
            var result = await DisplayDevicesService.CreateDeviceAsync(newDevice);

            if (result != null)
            {
                await HideCreateModal();
                await LoadDevices();
            }
            else
            {
                createErrorMessage = "Không thể tạo thiết bị. Vui lòng thử lại.";
            }
        }
        catch (Exception ex)
        {
            createErrorMessage = $"Lỗi khi tạo thiết bị: {ex.Message}";
        }
        finally
        {
            isCreating = false;
        }
    }
}