@page "/displaydevices"
@using Hgs.Share.Requests.DisplayDevices
@using Hgs.Share.Responses.DisplayDevices
@using BlazorBootstrap
@inject WebApp.Client.Services.DisplayDevicesService DisplayDevicesService

<PageTitle>Display Devices</PageTitle>

<div class="container">
    <div class="row">
        <div class="col-12">
            <div class="d-flex justify-content-between align-items-center mb-4">
                <h2>Display Devices</h2>
                <div class="d-flex gap-2">
                    <Button Color="ButtonColor.Secondary" Outline="true" @onclick="LoadDevices" aria-label="Refresh display devices">
                        <Icon Name="IconName.ArrowClockwise" /> Refresh
                    </Button>
                    <Button Color="ButtonColor.Primary" @onclick="ShowCreateModal">
                        <Icon Name="IconName.PlusLg" /> Add Device
                    </Button>
                </div>
            </div>

            <Card>
                <CardBody>
                    @if (isLoading)
                    {
                        <div class="text-center py-5">
                            <Spinner Color="SpinnerColor.Primary" />
                        </div>
                    }
                    else if (errorMessage != null)
                    {
                        <HgsErrorState Message="@errorMessage" RetryClick="@LoadDevices" />
                    }
                    else if (devices != null && !devices.Any())
                    {
                        <HgsEmptyState Title="No display devices found"
                                       Message="Click Add Device to register the first display device."
                                       ShowAction="true"
                                       ActionText="Add Device"
                                       ActionClick="@ShowCreateModal" />
                    }
                    else
                    {
                        <Grid TItem="DisplayDevicesGetAllResponse" Data="devices" AllowPaging="true" AllowSorting="true" Responsive="true"
                              Class="table table-hover table-bordered table-striped" PageSize="10">
                            <GridColumn TItem="DisplayDevicesGetAllResponse" HeaderText="ID" SortKeyExpression="item => item.Id">
                                @context.Id
                            </GridColumn>
                            <GridColumn TItem="DisplayDevicesGetAllResponse" HeaderText="Device Name" SortKeyExpression="item => item.DeviceName">
                                @context.DeviceName
                            </GridColumn>
                            <GridColumn TItem="DisplayDevicesGetAllResponse" HeaderText="Device Identifier" SortKeyExpression="item => item.DeviceIdentifier">
                                @context.DeviceIdentifier
                            </GridColumn>
                            <GridColumn TItem="DisplayDevicesGetAllResponse" HeaderText="Status" SortKeyExpression="item => item.Status">
                                <Badge Color="@(context.Status == "ACTIVE" ? BadgeColor.Success : BadgeColor.Secondary)">@context.Status</Badge>
                            </GridColumn>
                            <GridColumn TItem="DisplayDevicesGetAllResponse" HeaderText="Enabled">
                                @if (context.IsEnabled)
                                {
                                    <Badge Color="BadgeColor.Success">Yes</Badge>
                                }
                                else
                                {
                                    <Badge Color="BadgeColor.Danger">No</Badge>
                                }
                            </GridColumn>
                            <GridColumn TItem="DisplayDevicesGetAllResponse" HeaderText="Last Seen" SortKeyExpression="item => item.LastSeenAt">
                                @(context.LastSeenAt?.ToString("yyyy-MM-dd HH:mm:ss") ?? "Never")
                            </GridColumn>
                        </Grid>
                    }
                </CardBody>
            </Card>
        </div>
    </div>
</div>

<Modal @ref="createModal" Title="Add New Display Device">
    <BodyTemplate>
        <div class="mb-3">
            <label class="form-label" for="deviceName">Device Name *</label>
            <InputText id="deviceName" class="form-control" @bind-Value="newDevice.DeviceName" placeholder="Enter device name" />
        </div>
        <div class="mb-3">
            <label class="form-label" for="deviceIdentifier">Device Identifier *</label>
            <InputText id="deviceIdentifier" class="form-control" @bind-Value="newDevice.DeviceIdentifier" placeholder="Enter device identifier" />
        </div>
        <div class="mb-3">
            <label class="form-label" for="deviceStatus">Status</label>
            <InputText id="deviceStatus" class="form-control" @bind-Value="newDevice.Status" placeholder="ACTIVE" />
        </div>
        <div class="mb-3 form-check">
            <InputCheckbox id="deviceEnabled" class="form-check-input" @bind-Value="newDevice.IsEnabled" />
            <label class="form-check-label" for="deviceEnabled">Enable this device</label>
        </div>
        @if (!string.IsNullOrEmpty(createErrorMessage))
        {
            <Alert Color="AlertColor.Danger" role="alert">@createErrorMessage</Alert>
        }
    </BodyTemplate>
    <FooterTemplate>
        <Button Color="ButtonColor.Secondary" @onclick="HideCreateModal" Disabled="@isCreating">Cancel</Button>
        <Button Color="ButtonColor.Primary" @onclick="HandleCreateDevice" Disabled="@isCreating">
            @if (isCreating)
            {
                <Spinner Size="SpinnerSize.Small" />
            }
            else
            {
                <Icon Name="IconName.PlusLg" />
            }
            Create Device
        </Button>
    </FooterTemplate>
</Modal>

@code {
    private IEnumerable<DisplayDevicesGetAllResponse>? devices;
    private bool isLoading = true;
    private string? errorMessage;
    private bool showCreateModal = false;
    private bool isCreating = false;
    private string? createErrorMessage;
    private DisplayDevicesCreateRequest newDevice = new();
    private Modal? createModal;

    protected override async Task OnInitializedAsync()
    {
        await LoadDevices();
    }

    private async Task LoadDevices()
    {
        isLoading = true;
        errorMessage = null;
        devices = null;

        try
        {
            devices = await DisplayDevicesService.GetDisplayDevicesAsync();

            if (devices == null)
            {
                errorMessage = "Unable to load display devices. Please try again.";
            }
        }
        catch (Exception ex)
        {
            errorMessage = $"Error loading display devices: {ex.Message}";
        }
        finally
        {
            isLoading = false;
        }
    }

    private async Task ShowCreateModal()
    {
        newDevice = new DisplayDevicesCreateRequest();
        createErrorMessage = null;
        if (createModal != null)
        {
            await createModal.ShowAsync();
        }
    }

    private async Task HideCreateModal()
    {
        if (createModal != null)
        {
            await createModal.HideAsync();
        }
    }

    private async Task HandleCreateDevice()
    {
        if (string.IsNullOrWhiteSpace(newDevice.DeviceName) || string.IsNullOrWhiteSpace(newDevice.DeviceIdentifier))
        {
            createErrorMessage = "Device name and identifier are required.";
            return;
        }

        isCreating = true;
        createErrorMessage = null;

        try
        {
            var result = await DisplayDevicesService.CreateDeviceAsync(newDevice);

            if (result != null)
            {
                await HideCreateModal();
                await LoadDevices();
            }
            else
            {
                createErrorMessage = "Failed to create device. Please try again.";
            }
        }
        catch (Exception ex)
        {
            createErrorMessage = $"Error creating device: {ex.Message}";
        }
        finally
        {
            isCreating = false;
        }
    }
}