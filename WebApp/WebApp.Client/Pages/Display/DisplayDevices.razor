@page "/displaydevices"
@using Hgs.Share.Requests.DisplayDevices
@using Hgs.Share.Responses.DisplayDevices
@using Microsoft.AspNetCore.Components.Authorization
@inject AuthenticationStateProvider AuthenticationStateProvider
@inject NavigationManager NavigationManager

<div class="container mt-4">
    <div class="row">
        <div class="col-12">
            <div class="card">
                <div class="card-header d-flex justify-content-between align-items-center">
                    <h3 class="mb-0">Display Devices</h3>
                    <div>
                        <button class="btn btn-sm btn-primary me-2" @onclick="ShowCreateModal">
                            <i class="bi bi-plus-lg"></i> Add Device
                        </button>
                        <button class="btn btn-sm btn-outline-secondary" @onclick="LoadDevices">
                            <i class="bi bi-arrow-clockwise"></i> Refresh
                        </button>
                    </div>
                </div>
                <div class="card-body">
                    @if (isLoading)
                    {
                        <div class="text-center py-5">
                            <div class="spinner-border text-primary" role="status">
                                <span class="visually-hidden">Loading...</span>
                            </div>
                            <p class="mt-2">Loading display devices...</p>
                        </div>
                    }
                    else if (errorMessage != null)
                    {
                        <div class="alert alert-danger" role="alert">
                            <i class="bi bi-exclamation-triangle-fill"></i>
                            @errorMessage
                        </div>
                    }
                    else if (devices == null || !devices.Any())
                    {
                        <div class="alert alert-info" role="alert">
                            <i class="bi bi-info-circle-fill"></i>
                            No display devices found. Click "Add Device" to create one.
                        </div>
                    }
                    else
                    {
                        <div class="table-responsive">
                            <table class="table table-hover table-bordered table-striped">
                                <thead class="table-dark">
                                    <tr>
                                        <th>ID</th>
                                        <th>Device Name</th>
                                        <th>Device Identifier</th>
                                        <th>Status</th>
                                        <th>Enabled</th>
                                        <th>Last Seen</th>
                                    </tr>
                                </thead>
                                <tbody>
                                    @foreach (var device in devices)
                                    {
                                        <tr>
                                            <td>@device.Id</td>
                                            <td>@device.DeviceName</td>
                                            <td>@device.DeviceIdentifier</td>
                                            <td>
                                                <span class="badge @(device.Status == "ACTIVE" ? "bg-success" : "bg-secondary")">
                                                    @device.Status
                                                </span>
                                            </td>
                                            <td>
                                                @if (device.IsEnabled)
                                                {
                                                    <span class="badge bg-success">Yes</span>
                                                }
                                                else
                                                {
                                                    <span class="badge bg-danger">No</span>
                                                }
                                            </td>
                                            <td>
                                                @if (device.LastSeenAt.HasValue)
                                                {
                                                    @device.LastSeenAt.Value.ToString("yyyy-MM-dd HH:mm:ss")
                                                }
                                                else
                                                {
                                                    <span class="text-muted">Never</span>
                                                }
                                            </td>
                                        </tr>
                                    }
                                </tbody>
                            </table>
                        </div>
                        <div class="mt-3">
                            <small class="text-muted">Total: @devices.Count() device(s)</small>
                        </div>
                    }
                </div>
            </div>
        </div>
    </div>
</div>

<!-- Create Device Modal -->
@if (showCreateModal)
{
    <div class="modal fade show d-block" tabindex="-1" style="background-color: rgba(0,0,0,0.5);">
        <div class="modal-dialog">
            <div class="modal-content">
                <div class="modal-header">
                    <h5 class="modal-title">Add New Display Device</h5>
                    <button type="button" class="btn-close" @onclick="HideCreateModal"></button>
                </div>
                <div class="modal-body">
                    @if (isCreating)
                    {
                        <div class="text-center py-3">
                            <div class="spinner-border text-primary" role="status">
                                <span class="visually-hidden">Creating...</span>
                            </div>
                        </div>
                    }
                    else
                    {
                        <div class="mb-3">
                            <label class="form-label">Device Name *</label>
                            <input class="form-control" @bind="newDevice.DeviceName" placeholder="Enter device name" />
                        </div>
                        <div class="mb-3">
                            <label class="form-label">Device Identifier *</label>
                            <input class="form-control" @bind="newDevice.DeviceIdentifier" placeholder="Enter device identifier" />
                        </div>
                        <div class="mb-3">
                            <label class="form-label">Status</label>
                            <input class="form-control" @bind="newDevice.Status" placeholder="ACTIVE" />
                        </div>
                        <div class="mb-3">
                            <label class="form-label">Enabled</label>
                            <div class="form-check">
                                <input class="form-check-input" type="checkbox" @bind="newDevice.IsEnabled" />
                                <label class="form-check-label">Enable this device</label>
                            </div>
                        </div>
                        <div class="mb-3">
                            <label class="form-label">Last Seen</label>
                            <input type="datetime-local" class="form-control" @bind="newDevice.LastSeenAt" />
                        </div>
                        @if (!string.IsNullOrEmpty(createErrorMessage))
                        {
                            <div class="alert alert-danger" role="alert">
                                @createErrorMessage
                            </div>
                        }
                    }
                </div>
                <div class="modal-footer">
                    <button type="button" class="btn btn-secondary" @onclick="HideCreateModal" disabled="@isCreating">Cancel</button>
                    <button type="button" class="btn btn-primary" @onclick="HandleCreateDevice" disabled="@isCreating">Create Device</button>
                </div>
            </div>
        </div>
    </div>
}

@code {
    private IEnumerable<DisplayDevicesGetAllResponse>? devices;
    private bool isLoading = true;
    private string? errorMessage;
    private bool accessDenied = false;
    private bool showCreateModal = false;
    private bool isCreating = false;
    private string? createErrorMessage;
    private DisplayDevicesCreateRequest newDevice = new();

    protected override async Task OnInitializedAsync()
    {
        await LoadDevices();
    }

    private async Task LoadDevices()
    {
        isLoading = true;
        errorMessage = null;
        accessDenied = false;
        devices = null;

        try
        {
            // devices = await DisplayDevicesService.GetDisplayDevicesAsync();
            
            if (devices == null)
            {
                var authState = await AuthenticationStateProvider.GetAuthenticationStateAsync();
                var user = authState.User;
                
                if (user.Identity?.IsAuthenticated == true)
                {
                    accessDenied = true;
                }
                else
                {
                    errorMessage = "Unable to load display devices. Please try again.";
                }
            }
        }
        catch (Exception ex)
        {
            errorMessage = $"Error loading display devices: {ex.Message}";
        }
        finally
        {
            isLoading = false;
        }
    }

    private void ShowCreateModal()
    {
        showCreateModal = true;
        newDevice = new DisplayDevicesCreateRequest();
        createErrorMessage = null;
    }

    private void HideCreateModal()
    {
        showCreateModal = false;
        newDevice = new DisplayDevicesCreateRequest();
        createErrorMessage = null;
    }

    private async Task HandleCreateDevice()
    {
        if (string.IsNullOrWhiteSpace(newDevice.DeviceName) || string.IsNullOrWhiteSpace(newDevice.DeviceIdentifier))
        {
            createErrorMessage = "Device name and identifier are required.";
            return;
        }

        isCreating = true;
        createErrorMessage = null;

        try
        {
            // var result = await DisplayDevicesService.CreateDeviceAsync(newDevice);
            
            // if (result != null)
            // {
            //     HideCreateModal();
            //     await LoadDevices();
            // }
            // else
            // {
            //     createErrorMessage = "Failed to create device. Please try again.";
            // }
        }
        catch (Exception ex)
        {
            createErrorMessage = $"Error creating device: {ex.Message}";
        }
        finally
        {
            isCreating = false;
        }
    }
}