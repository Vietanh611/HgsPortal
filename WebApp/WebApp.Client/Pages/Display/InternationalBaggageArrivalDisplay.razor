@page "/display/InternationalBaggageArrivalDisplay"
@attribute [AllowAnonymous]
@layout EmptyLayout
@using Hgs.Share.Dtos
@using Hgs.Share.Responses.ApiResponses
@using Hgs.Share.Responses.CoreAssets
@using Microsoft.AspNetCore.Authorization
@using WebApp.Client.Services
@using WebApp.Client.Services.Network
@inject ApiClient ApiClient
@inject NavigationManager Navigation
@inject IJSRuntime JS
@inject KioskDeviceConfigService KioskConfig
@implements IAsyncDisposable

<link href="css/baggage-display.css" rel="stylesheet" />

<div class="container-fluid display-page">
    <KioskDeviceSetup Config="@kioskConfig" OnChanged="HandleConfigChanged" />
    @if (isLoading)
    {
        <div class="text-center py-5">
            <div class="spinner-border text-primary" role="status">
                <span class="visually-hidden">Loading...</span>
            </div>
        </div>
    }
    else if (errorMessage != null)
    {
        <div class="alert alert-danger" role="alert">
            @errorMessage
        </div>
    }
    else if (kioskConfig == null)
    {
        <div class="text-center py-5 text-muted">
            Nhập cấu hình thiết bị ở trên để bắt đầu hiển thị.
        </div>
    }
    else
    {
        <div>
            @if (!isLoading)
            {
                <Carousel ShowIndicators="false"
                          Crossfade="true"
                          Interval="5000"
                          Autoplay="CarouselAutoPlay.StartOnPageLoad">

                    @{
                        var isFirstItem = true;
                    }

                    @if (images != null && images.Any())
                    {
                        @foreach (var image in images)
                        {
                            <CarouselItem class="@(isFirstItem ? "active" : "")">
                                <div class="d-flex justify-content-center align-items-center w-100">
                                    <img src="@image.StoragePath"
                                         class="display-image"
                                         alt="@image.FileName" />
                                </div>
                            </CarouselItem>

                            isFirstItem = false;
                        }
                    }

                    @if (baggageData != null && baggageData.Any())
                    {
                        <CarouselItem class="@(isFirstItem ? "active" : "")">
                            <div class="arrival-item">
                                <div class="arrival-logo">
                                    <img src="@($"{Navigation.BaseUri}assets/hgs/new%20logo/logo.png")"
                                         alt="HGS" />
                                </div>

                                <div class="card">
                                    <div class="card-header current-flights-header">
                                        <h5 class="mb-0 current-flights-title">NOW HANDLING</h5>
                                    </div>

                                    <div class="card-body">
                                        <div class="table-responsive">
                                            <table class="arrival-display-table">
                                                <thead>
                                                    <tr>
                                                        <th><i class="bi bi-airplane"></i> Carrier</th>
                                                        <th><i class="bi bi-airplane-fill"></i> Flight</th>
                                                        <th><i class="bi bi-geo-alt"></i> Depart From</th>
                                                        <th><i class="bi bi-bag"></i> Belt No.</th>
                                                    </tr>
                                                </thead>

                                                <tbody>
                                                    @foreach (var baggage in baggageData)
                                                    {
                                                        <tr>
                                                            <td>
                                                                <img src="@($"{Navigation.BaseUri}{baggage.Path}")"
                                                                     alt="Logo"
                                                                     class="img-fluid"
                                                                     style="max-height: 50px;" />
                                                            </td>

                                                            <td>@baggage.FlightNo</td>

                                                            <td>
                                                                <div class="route-city">
                                                                    <div class="route">@baggage.Route</div>
                                                                    <div class="city">@baggage.NameCity</div>
                                                                </div>
                                                            </td>

                                                            <td>
                                                                @if (!string.IsNullOrEmpty(baggage.Belt))
                                                                {
                                                                    <span>@baggage.Belt</span>
                                                                }
                                                                else
                                                                {
                                                                    <span class="text-muted">N/A</span>
                                                                }
                                                            </td>
                                                        </tr>
                                                    }
                                                </tbody>
                                            </table>
                                        </div>
                                    </div>
                                </div>
                            </div>
                        </CarouselItem>

                        isFirstItem = false;
                    }

                </Carousel>
            }

        </div>
    }
</div>

@code {
    private List<BaggageArrivalDisplayDto>? baggageData;
    private List<CoreAssetsGetAllResponse>? images;
    private KioskDeviceConfig? kioskConfig;
    private bool isLoading = true;
    private string? errorMessage;
    private int carouselKey = 0;
    private PeriodicTimer? timer;
    private CancellationTokenSource? cts;

    protected override async Task OnInitializedAsync()
    {
        cts = new CancellationTokenSource();
        kioskConfig = await KioskConfig.GetAsync();
        await LoadData();
        isLoading = false;
        timer = new PeriodicTimer(TimeSpan.FromMinutes(1));

        _ = PollAsync(cts.Token);
    }

    private async Task PollAsync(CancellationToken token)
    {
        try
        {
            while (await timer!.WaitForNextTickAsync(token))
            {
                await InvokeAsync(LoadData);
            }
        }
        catch (OperationCanceledException)
        {
        }
    }

    public ValueTask DisposeAsync()
    {
        cts?.Cancel();
        timer?.Dispose();
        cts?.Dispose();

        return ValueTask.CompletedTask;
    }

    private async Task LoadData()
    {
        errorMessage = null;

        try
        {
            var headers = kioskConfig != null
                ? new Dictionary<string, string>
                {
                    ["X-Device-Id"] = kioskConfig.DeviceId,
                    ["X-Device-Key"] = kioskConfig.DeviceKey
                }
                : null;

            var baggageResponse = await ApiClient.GetAsync<ApiResponse<IEnumerable<BaggageArrivalDisplayDto>>>("api/display/GetInternationalBaggageArrivalDisplay", headers: headers);

            if (baggageResponse != null && baggageResponse.Success && baggageResponse.Data != null)
            {
                baggageData = baggageResponse.Data.ToList();
            }

            var assetsResponse = await ApiClient.GetAsync<ApiResponse<IEnumerable<CoreAssetsGetAllResponse>>>("api/coreassets", headers: headers);
            if (assetsResponse != null && assetsResponse.Success && assetsResponse.Data != null)
            {
                images = assetsResponse.Data
                    .Where(a => a.Code == "ARRIVAL_DISPLAY" && a.IsActive)
                    .ToList();
            }
            StateHasChanged();
        }
        catch (Exception ex)
        {
            errorMessage = $"Lỗi khi tải dữ liệu: {ex.Message}";
        }
        finally
        {
            carouselKey++;
        }
    }

    private async Task HandleConfigChanged()
    {
        kioskConfig = await KioskConfig.GetAsync();
        errorMessage = null;
        await LoadData();
        StateHasChanged();
    }

}
