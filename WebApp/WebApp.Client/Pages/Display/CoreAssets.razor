@page "/coreassets"
@using Hgs.Share.Requests.CoreAssets
@using Hgs.Share.Responses.CoreAssets
@using BlazorBootstrap
@inject WebApp.Client.Services.CoreAssetsService CoreAssetsService

<PageTitle>Tài sản cốt lõi</PageTitle>

<div class="container">
    <div class="row">
        <div class="col-12">
            <div class="d-flex justify-content-between align-items-center mb-4">
                <h1 class="h2 mb-0">Tài sản cốt lõi</h1>
                <div class="d-flex gap-2">
                    <Button Color="ButtonColor.Secondary" Outline="true" @onclick="LoadAssets" aria-label="Làm mới danh sách tài sản">
                        <Icon Name="IconName.ArrowClockwise" /> Làm mới
                    </Button>
                    <Button Color="ButtonColor.Primary" @onclick="ShowCreateModal">
                        <Icon Name="IconName.PlusLg" /> Thêm tài sản
                    </Button>
                </div>
            </div>

            <Card>
                <CardBody>
                    @if (isLoading)
                    {
                        <div class="text-center py-5">
                            <Spinner Color="SpinnerColor.Primary" />
                        </div>
                    }
                    else if (errorMessage != null)
                    {
                        <HgsErrorState Message="@errorMessage" RetryClick="@LoadAssets" />
                    }
                    else if (assets != null && !assets.Any())
                    {
                        <HgsEmptyState Title="Chưa có tài sản cốt lõi"
                                       Message="Nhấn Thêm tài sản để đăng ký tài sản cốt lõi đầu tiên."
                                       ShowAction="true"
                                       ActionText="Thêm tài sản"
                                       ActionClick="@ShowCreateModal" />
                    }
                    else
                    {
                        <Grid TItem="CoreAssetsGetAllResponse" Data="assets" AllowPaging="true" AllowSorting="true" Responsive="true"
                              Class="table table-hover table-bordered table-striped" PageSize="10">
                            <GridColumn TItem="CoreAssetsGetAllResponse" HeaderText="ID" SortKeyExpression="item => item.Id">
                                @context.Id
                            </GridColumn>
                            <GridColumn TItem="CoreAssetsGetAllResponse" HeaderText="Mã" SortKeyExpression="item => item.Code">
                                @context.Code
                            </GridColumn>
                            <GridColumn TItem="CoreAssetsGetAllResponse" HeaderText="Tên tệp" SortKeyExpression="item => item.FileName">
                                @(context.FileName ?? "N/A")
                            </GridColumn>
                            <GridColumn TItem="CoreAssetsGetAllResponse" HeaderText="Loại nội dung" SortKeyExpression="item => item.ContentType">
                                @(context.ContentType ?? "N/A")
                            </GridColumn>
                            <GridColumn TItem="CoreAssetsGetAllResponse" HeaderText="Loại tài sản" SortKeyExpression="item => item.AssetType">
                                <Badge Color="BadgeColor.Info">@context.AssetType</Badge>
                            </GridColumn>
                            <GridColumn TItem="CoreAssetsGetAllResponse" HeaderText="Đường dẫn lưu trữ" SortKeyExpression="item => item.StoragePath">
                                <small class="text-muted">@context.StoragePath</small>
                            </GridColumn>
                            <GridColumn TItem="CoreAssetsGetAllResponse" HeaderText="Kích hoạt">
                                @if (context.IsActive)
                                {
                                    <Badge Color="BadgeColor.Success">Có</Badge>
                                }
                                else
                                {
                                    <Badge Color="BadgeColor.Danger">Không</Badge>
                                }
                            </GridColumn>
                        </Grid>
                    }
                </CardBody>
            </Card>
        </div>
    </div>
</div>

<Modal @ref="createModal" Title="Thêm tài sản cốt lõi mới" Size="ModalSize.Large">
    <BodyTemplate>
        <div class="row g-3">
            <div class="col-md-6">
                <label class="form-label" for="assetCode">Mã *</label>
                <InputText id="assetCode" class="form-control" @bind-Value="newAsset.Code" placeholder="Nhập mã tài sản" />
            </div>
            <div class="col-md-6">
                <label class="form-label" for="assetFileName">Tên tệp</label>
                <InputText id="assetFileName" class="form-control" @bind-Value="newAsset.FileName" placeholder="Nhập tên tệp" />
            </div>
            <div class="col-md-6">
                <label class="form-label" for="assetContentType">Loại nội dung</label>
                <InputText id="assetContentType" class="form-control" @bind-Value="newAsset.ContentType" placeholder="ví dụ: image/png" />
            </div>
            <div class="col-md-6">
                <label class="form-label" for="assetStoragePath">Đường dẫn lưu trữ *</label>
                <InputText id="assetStoragePath" class="form-control" @bind-Value="newAsset.StoragePath" placeholder="Nhập đường dẫn lưu trữ" />
            </div>
            <div class="col-md-6">
                <label class="form-label" for="assetType">Loại tài sản *</label>
                <select id="assetType" class="form-select" @bind="newAsset.AssetType">
                    <option value="">Chọn loại...</option>
                    <option value="Logo">Logo</option>
                    <option value="Image">Hình ảnh</option>
                    <option value="Icon">Biểu tượng</option>
                    <option value="Document">Tài liệu</option>
                    <option value="Video">Video</option>
                </select>
            </div>
            <div class="col-md-6 d-flex align-items-center">
                <div class="form-check mb-0">
                    <InputCheckbox id="assetActive" class="form-check-input" @bind-Value="newAsset.IsActive" />
                    <label class="form-check-label" for="assetActive">Kích hoạt tài sản này</label>
                </div>
            </div>
        </div>
        @if (!string.IsNullOrEmpty(createErrorMessage))
        {
            <Alert Color="AlertColor.Danger" role="alert" class="mt-3">@createErrorMessage</Alert>
        }
    </BodyTemplate>
    <FooterTemplate>
        <Button Color="ButtonColor.Secondary" @onclick="HideCreateModal" Disabled="@isCreating">Hủy</Button>
        <Button Color="ButtonColor.Primary" @onclick="HandleCreateAsset" Disabled="@isCreating">
            @if (isCreating)
            {
                <Spinner Color="SpinnerColor.Light" Size="SpinnerSize.Small" class="me-2" />
            }
            else
            {
                <Icon Name="IconName.PlusLg" />
            }
            Tạo tài sản
        </Button>
    </FooterTemplate>
</Modal>

@code {
    private IEnumerable<CoreAssetsGetAllResponse>? assets;
    private bool isLoading = true;
    private string? errorMessage;
    private bool isCreating = false;
    private string? createErrorMessage;
    private CoreAssetsCreateRequest newAsset = new();
    private Modal? createModal;

    protected override async Task OnInitializedAsync()
    {
        await LoadAssets();
    }

    private async Task LoadAssets()
    {
        isLoading = true;
        errorMessage = null;
        assets = null;

        try
        {
            assets = await CoreAssetsService.GetCoreAssetsAsync();

            if (assets == null)
            {
                errorMessage = "Không thể tải danh sách tài sản cốt lõi. Vui lòng thử lại.";
            }
        }
        catch (Exception ex)
        {
            errorMessage = $"Lỗi khi tải danh sách tài sản cốt lõi: {ex.Message}";
        }
        finally
        {
            isLoading = false;
        }
    }

    private async Task ShowCreateModal()
    {
        newAsset = new CoreAssetsCreateRequest();
        createErrorMessage = null;
        if (createModal != null)
        {
            await createModal.ShowAsync();
        }
    }

    private async Task HideCreateModal()
    {
        if (createModal != null)
        {
            await createModal.HideAsync();
        }
    }

    private async Task HandleCreateAsset()
    {
        if (string.IsNullOrWhiteSpace(newAsset.Code) || string.IsNullOrWhiteSpace(newAsset.StoragePath) || string.IsNullOrWhiteSpace(newAsset.AssetType))
        {
            createErrorMessage = "Mã, đường dẫn lưu trữ và loại tài sản là bắt buộc.";
            return;
        }

        isCreating = true;
        createErrorMessage = null;

        try
        {
            var result = await CoreAssetsService.CreateAssetAsync(newAsset);

            if (result != null)
            {
                await HideCreateModal();
                await LoadAssets();
            }
            else
            {
                createErrorMessage = "Không thể tạo tài sản. Vui lòng thử lại.";
            }
        }
        catch (Exception ex)
        {
            createErrorMessage = $"Lỗi khi tạo tài sản: {ex.Message}";
        }
        finally
        {
            isCreating = false;
        }
    }
}