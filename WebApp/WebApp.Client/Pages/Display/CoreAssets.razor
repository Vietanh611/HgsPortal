@page "/coreassets"
@using Hgs.Share.Requests.CoreAssets
@using Hgs.Share.Responses.CoreAssets
@using BlazorBootstrap
@inject WebApp.Client.Services.CoreAssetsService CoreAssetsService

<PageTitle>Core Assets</PageTitle>

<div class="container">
    <div class="row">
        <div class="col-12">
            <div class="d-flex justify-content-between align-items-center mb-4">
                <h2>Core Assets</h2>
                <div class="d-flex gap-2">
                    <Button Color="ButtonColor.Secondary" Outline="true" @onclick="LoadAssets" aria-label="Refresh core assets">
                        <Icon Name="IconName.ArrowClockwise" /> Refresh
                    </Button>
                    <Button Color="ButtonColor.Primary" @onclick="ShowCreateModal">
                        <Icon Name="IconName.PlusLg" /> Add Asset
                    </Button>
                </div>
            </div>

            <Card>
                <CardBody>
                    @if (isLoading)
                    {
                        <div class="text-center py-5">
                            <Spinner Color="SpinnerColor.Primary" />
                        </div>
                    }
                    else if (errorMessage != null)
                    {
                        <HgsErrorState Message="@errorMessage" RetryClick="@LoadAssets" />
                    }
                    else if (assets != null && !assets.Any())
                    {
                        <HgsEmptyState Title="No core assets found"
                                       Message="Click Add Asset to register the first core asset."
                                       ShowAction="true"
                                       ActionText="Add Asset"
                                       ActionClick="@ShowCreateModal" />
                    }
                    else
                    {
                        <Grid TItem="CoreAssetsGetAllResponse" Data="assets" AllowPaging="true" AllowSorting="true" Responsive="true"
                              Class="table table-hover table-bordered table-striped" PageSize="10">
                            <GridColumn TItem="CoreAssetsGetAllResponse" HeaderText="ID" SortKeyExpression="item => item.Id">
                                @context.Id
                            </GridColumn>
                            <GridColumn TItem="CoreAssetsGetAllResponse" HeaderText="Code" SortKeyExpression="item => item.Code">
                                @context.Code
                            </GridColumn>
                            <GridColumn TItem="CoreAssetsGetAllResponse" HeaderText="File Name" SortKeyExpression="item => item.FileName">
                                @(context.FileName ?? "N/A")
                            </GridColumn>
                            <GridColumn TItem="CoreAssetsGetAllResponse" HeaderText="Content Type" SortKeyExpression="item => item.ContentType">
                                @(context.ContentType ?? "N/A")
                            </GridColumn>
                            <GridColumn TItem="CoreAssetsGetAllResponse" HeaderText="Asset Type" SortKeyExpression="item => item.AssetType">
                                <Badge Color="BadgeColor.Info">@context.AssetType</Badge>
                            </GridColumn>
                            <GridColumn TItem="CoreAssetsGetAllResponse" HeaderText="Storage Path" SortKeyExpression="item => item.StoragePath">
                                <small class="text-muted">@context.StoragePath</small>
                            </GridColumn>
                            <GridColumn TItem="CoreAssetsGetAllResponse" HeaderText="Active">
                                @if (context.IsActive)
                                {
                                    <Badge Color="BadgeColor.Success">Yes</Badge>
                                }
                                else
                                {
                                    <Badge Color="BadgeColor.Danger">No</Badge>
                                }
                            </GridColumn>
                        </Grid>
                    }
                </CardBody>
            </Card>
        </div>
    </div>
</div>

<Modal @ref="createModal" Title="Add New Core Asset">
    <BodyTemplate>
        <div class="mb-3">
            <label class="form-label" for="assetCode">Code *</label>
            <InputText id="assetCode" class="form-control" @bind-Value="newAsset.Code" placeholder="Enter asset code" />
        </div>
        <div class="mb-3">
            <label class="form-label" for="assetFileName">File Name</label>
            <InputText id="assetFileName" class="form-control" @bind-Value="newAsset.FileName" placeholder="Enter file name" />
        </div>
        <div class="mb-3">
            <label class="form-label" for="assetContentType">Content Type</label>
            <InputText id="assetContentType" class="form-control" @bind-Value="newAsset.ContentType" placeholder="e.g., image/png" />
        </div>
        <div class="mb-3">
            <label class="form-label" for="assetStoragePath">Storage Path *</label>
            <InputText id="assetStoragePath" class="form-control" @bind-Value="newAsset.StoragePath" placeholder="Enter storage path" />
        </div>
        <div class="mb-3">
            <label class="form-label" for="assetType">Asset Type *</label>
            <select id="assetType" class="form-select" @bind="newAsset.AssetType">
                <option value="">Select type...</option>
                <option value="Logo">Logo</option>
                <option value="Image">Image</option>
                <option value="Icon">Icon</option>
                <option value="Document">Document</option>
                <option value="Video">Video</option>
            </select>
        </div>
        <div class="mb-3 form-check">
            <InputCheckbox id="assetActive" class="form-check-input" @bind-Value="newAsset.IsActive" />
            <label class="form-check-label" for="assetActive">Enable this asset</label>
        </div>
        @if (!string.IsNullOrEmpty(createErrorMessage))
        {
            <Alert Color="AlertColor.Danger" role="alert">@createErrorMessage</Alert>
        }
    </BodyTemplate>
    <FooterTemplate>
        <Button Color="ButtonColor.Secondary" @onclick="HideCreateModal" Disabled="@isCreating">Cancel</Button>
        <Button Color="ButtonColor.Primary" @onclick="HandleCreateAsset" Disabled="@isCreating">
            @if (isCreating)
            {
                <Spinner Color="SpinnerColor.Light" Size="SpinnerSize.Small" class="me-2" />
            }
            else
            {
                <Icon Name="IconName.PlusLg" />
            }
            Create Asset
        </Button>
    </FooterTemplate>
</Modal>

@code {
    private IEnumerable<CoreAssetsGetAllResponse>? assets;
    private bool isLoading = true;
    private string? errorMessage;
    private bool isCreating = false;
    private string? createErrorMessage;
    private CoreAssetsCreateRequest newAsset = new();
    private Modal? createModal;

    protected override async Task OnInitializedAsync()
    {
        await LoadAssets();
    }

    private async Task LoadAssets()
    {
        isLoading = true;
        errorMessage = null;
        assets = null;

        try
        {
            assets = await CoreAssetsService.GetCoreAssetsAsync();

            if (assets == null)
            {
                errorMessage = "Unable to load core assets. Please try again.";
            }
        }
        catch (Exception ex)
        {
            errorMessage = $"Error loading core assets: {ex.Message}";
        }
        finally
        {
            isLoading = false;
        }
    }

    private async Task ShowCreateModal()
    {
        newAsset = new CoreAssetsCreateRequest();
        createErrorMessage = null;
        if (createModal != null)
        {
            await createModal.ShowAsync();
        }
    }

    private async Task HideCreateModal()
    {
        if (createModal != null)
        {
            await createModal.HideAsync();
        }
    }

    private async Task HandleCreateAsset()
    {
        if (string.IsNullOrWhiteSpace(newAsset.Code) || string.IsNullOrWhiteSpace(newAsset.StoragePath) || string.IsNullOrWhiteSpace(newAsset.AssetType))
        {
            createErrorMessage = "Code, Storage Path, and Asset Type are required.";
            return;
        }

        isCreating = true;
        createErrorMessage = null;

        try
        {
            var result = await CoreAssetsService.CreateAssetAsync(newAsset);

            if (result != null)
            {
                await HideCreateModal();
                await LoadAssets();
            }
            else
            {
                createErrorMessage = "Failed to create asset. Please try again.";
            }
        }
        catch (Exception ex)
        {
            createErrorMessage = $"Error creating asset: {ex.Message}";
        }
        finally
        {
            isCreating = false;
        }
    }
}