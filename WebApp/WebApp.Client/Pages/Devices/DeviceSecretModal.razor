@using Hgs.Share.Responses.Devices
@using BlazorBootstrap

<Modal @ref="modal" Title="Cấu hình thiết bị" Size="ModalSize.Large" OnClose="Close">
    <BodyTemplate>
        @if (Device != null)
        {
            @if (ShowPairingCode)
            {
                <div class="alert alert-warning d-flex align-items-center gap-2 mb-3" role="alert">
                    <Icon Name="IconName.ExclamationTriangleFill" />
                    <span>Mã ghép chỉ hiển thị <strong>một lần duy nhất</strong> và hết hạn trong 10 phút.
                        Hãy sao chép và đưa cho người vận hành kiosk nhập ngay.</span>
                </div>
            }

            <div class="mb-3">
                <label class="form-label">Tên thiết bị</label>
                <div class="fw-semibold">@Device.DeviceName</div>
            </div>

            <div class="row g-3 mb-3">
                <div class="col-md-6">
                    <label class="form-label">Loại thiết bị</label>
                    <div class="fw-semibold">@GetDeviceTypeLabel(Device.DeviceType)</div>
                </div>
                <div class="col-md-6">
                    <label class="form-label">Trạng thái</label>
                    <div class="fw-semibold">@GetStatusLabel(Device.Status)</div>
                </div>
            </div>

            @if (!string.IsNullOrWhiteSpace(Device.DeviceIdentifier))
            {
                <div class="mb-3">
                    <label class="form-label">Mã định danh thiết bị</label>
                    <div class="input-group">
                        <input type="text" class="form-control" readonly value="@Device.DeviceIdentifier" />
                        <Button Color="ButtonColor.Secondary" Outline="true" @onclick="CopyIdentifier">
                            <Icon Name="IconName.Clipboard2Check" /> Sao chép
                        </Button>
                    </div>
                </div>
            }

            @if (ShowPairingCode && !string.IsNullOrWhiteSpace(SecretValue))
            {
                <div class="mb-3">
                    <label class="form-label">Mã ghép (8 ký tự)</label>
                    <div class="input-group">
                        <input type="text" class="form-control font-monospace text-uppercase" readonly value="@SecretValue" />
                        <Button Color="ButtonColor.Secondary" Outline="true" @onclick="CopySecret">
                            <Icon Name="IconName.Clipboard2Check" /> Sao chép
                        </Button>
                    </div>
                </div>
            }
        }
    </BodyTemplate>
    <FooterTemplate>
        <Button Color="ButtonColor.Primary" @onclick="Close">Đóng</Button>
    </FooterTemplate>
</Modal>

@code {
    private Modal modal = default!;
    private string? SecretValue;
    private bool ShowPairingCode;

    private DeviceGetByIdResponse? Device { get; set; }

    public async Task ShowAsync(DevicePairingCodeCreateResponse response)
    {
        SecretValue = response.PairingCode;
        ShowPairingCode = true;
        Device = new DeviceGetByIdResponse
        {
            Id = response.DeviceRowId,
            DeviceType = response.DeviceType,
            DeviceName = response.DeviceName,
            DeviceIdentifier = response.DeviceIdentifier,
            OrganizationUnitId = response.OrganizationUnitId,
            Status = "PENDING"
        };
        await modal.ShowAsync();
    }

    public async Task ShowAsync(DevicePairingCodeRegenerateResponse response)
    {
        SecretValue = response.PairingCode;
        ShowPairingCode = true;
        Device = new DeviceGetByIdResponse
        {
            Id = response.DeviceRowId,
            DeviceType = DeviceTypesDefault,
            DeviceName = response.DeviceName,
            DeviceIdentifier = response.DeviceIdentifier,
            Status = "PENDING"
        };
        await modal.ShowAsync();
    }

    public async Task ShowAsync(DeviceGetByIdResponse response)
    {
        SecretValue = null;
        ShowPairingCode = false;
        Device = response;
        await modal.ShowAsync();
    }

    public async Task ShowAsync(DeviceGetAllResponse response)
    {
        SecretValue = null;
        ShowPairingCode = false;
        Device = new DeviceGetByIdResponse
        {
            Id = response.Id,
            DeviceType = response.DeviceType,
            DeviceName = response.DeviceName,
            DeviceIdentifier = response.DeviceIdentifier,
            OrganizationUnitId = response.OrganizationUnitId,
            Status = response.Status,
            LastSeenAt = response.LastSeenAt,
            IsEnabled = response.IsEnabled
        };
        await modal.ShowAsync();
    }

    private const string DeviceTypesDefault = "KIOSK_WEB";

    public async Task HideAsync()
    {
        await modal.HideAsync();
    }

    private async Task Close()
    {
        await modal.HideAsync();
    }

    private async Task CopyIdentifier()
    {
        if (Device == null)
        {
            return;
        }

        await CopyTextAsync(Device.DeviceIdentifier, "Mã định danh");
    }

    private async Task CopySecret()
    {
        if (string.IsNullOrWhiteSpace(SecretValue))
        {
            return;
        }

        await CopyTextAsync(SecretValue, "Mã ghép");
    }

    private async Task CopyTextAsync(string text, string label)
    {
        try
        {
            await JS.InvokeVoidAsync("hgsCopyToClipboard", text);
        }
        catch (Exception ex)
        {
            Console.WriteLine($"Clipboard error: {ex.Message}");
        }
    }

    private string GetDeviceTypeLabel(string deviceType) => deviceType switch
    {
        "KIOSK_WEB" => "Kiosk (Web)",
        _ => deviceType
    };

    private string GetStatusLabel(string status) => status switch
    {
        "ONLINE" => "Đang hoạt động",
        "ACTIVE" => "Kích hoạt",
        "PENDING" => "Chờ ghép cặp",
        "DISABLED" => "Đã tắt",
        "REVOKED" => "Đã thu hồi",
        _ => status
    };
}