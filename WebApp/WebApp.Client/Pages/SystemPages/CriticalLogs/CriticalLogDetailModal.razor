@using Hgs.Share.Responses.CriticalLogs
@using BlazorBootstrap

<Modal @ref="modal" Title="Chi tiết nhật ký lỗi" OnClose="Close" Size="ModalSize.Large">
    <BodyTemplate>
        @if (Log != null)
        {
            <div class="row">
                <div class="col-md-6 mb-3">
                    <label class="form-label fw-bold">ID</label>
                    <div>@Log.Id</div>
                </div>
                <div class="col-md-6 mb-3">
                    <label class="form-label fw-bold">Mức độ</label>
                    <div>
                        <Badge Color="@(GetLevelBadgeColor(Log.Level))">@Log.Level</Badge>
                    </div>
                </div>
                <div class="col-md-6 mb-3">
                    <label class="form-label fw-bold">Thời gian</label>
                    <div>@Log.TimeStamp.ToLocalTime().ToString("yyyy-MM-dd HH:mm:ss")</div>
                </div>
                <div class="col-md-6 mb-3">
                    <label class="form-label fw-bold">Người dùng</label>
                    <div>@(Log.User ?? "N/A")</div>
                </div>
                <div class="col-md-6 mb-3">
                    <label class="form-label fw-bold">Phương thức</label>
                    <div>@(Log.Method ?? "N/A")</div>
                </div>
                <div class="col-md-6 mb-3">
                    <label class="form-label fw-bold">Path</label>
                    <div>@(Log.Path ?? "N/A")</div>
                </div>
                <div class="col-md-6 mb-3">
                    <label class="form-label fw-bold">Request ID</label>
                    <div>@(Log.RequestId ?? "N/A")</div>
                </div>
                <div class="col-12 mb-3">
                    <div class="d-flex justify-content-between align-items-center">
                        <label class="form-label fw-bold mb-0">Message</label>
                        <Button Color="ButtonColor.Secondary" Outline="true" Size="ButtonSize.Small"
                                @onclick="CopyMessageAsync" aria-label="Sao chép Message">
                            <Icon Name="@(copiedField == FieldMessage ? IconName.Clipboard2CheckFill : IconName.Clipboard2)" />
                            @(copiedField == FieldMessage ? "Đã sao chép" : "Sao chép")
                        </Button>
                    </div>
                    <pre class="bg-light p-3 rounded mt-2" style="max-height: 200px; overflow-y: auto;">@(Log.Message ?? "N/A")</pre>
                </div>
                @if (!string.IsNullOrEmpty(Log.MessageTemplate))
                {
                    <div class="col-12 mb-3">
                        <label class="form-label fw-bold">Message template</label>
                        <pre class="bg-light p-3 rounded" style="max-height: 200px; overflow-y: auto;">@Log.MessageTemplate</pre>
                    </div>
                }
                @if (!string.IsNullOrEmpty(Log.Exception))
                {
                    <div class="col-12 mb-3">
                        <div class="d-flex justify-content-between align-items-center">
                            <label class="form-label fw-bold mb-0">Exception</label>
                            <Button Color="ButtonColor.Secondary" Outline="true" Size="ButtonSize.Small"
                                    @onclick="CopyExceptionAsync" aria-label="Sao chép Exception">
                                <Icon Name="@(copiedField == FieldException ? IconName.Clipboard2CheckFill : IconName.Clipboard2)" />
                                @(copiedField == FieldException ? "Đã sao chép" : "Sao chép")
                            </Button>
                        </div>
                        <pre class="bg-light p-3 rounded mt-2" style="max-height: 400px; overflow-y: auto;">@Log.Exception</pre>
                    </div>
                }
                @if (!string.IsNullOrEmpty(Log.Properties))
                {
                    <div class="col-12 mb-3">
                        <div class="d-flex justify-content-between align-items-center">
                            <label class="form-label fw-bold mb-0">Properties</label>
                            <Button Color="ButtonColor.Secondary" Outline="true" Size="ButtonSize.Small"
                                    @onclick="CopyPropertiesAsync" aria-label="Sao chép Properties">
                                <Icon Name="@(copiedField == FieldProperties ? IconName.Clipboard2CheckFill : IconName.Clipboard2)" />
                                @(copiedField == FieldProperties ? "Đã sao chép" : "Sao chép")
                            </Button>
                        </div>
                        <pre class="bg-light p-3 rounded mt-2" style="max-height: 300px; overflow-y: auto;">@FormatProperties(Log.Properties)</pre>
                    </div>
                }
            </div>
        }
    </BodyTemplate>
    <FooterTemplate>
        <Button Color="ButtonColor.Secondary" @onclick="OnClose">Đóng</Button>
    </FooterTemplate>
</Modal>

@code {
    private Modal modal = default!;
    [Parameter] public CriticalLogsGetAllResponse? Log { get; set; }
    [Parameter] public EventCallback OnClose { get; set; }

    private const string FieldMessage = "Message";
    private const string FieldException = "Exception";
    private const string FieldProperties = "Properties";

    // Trường vừa copy — dùng để đổi nhãn nút thành "Đã sao chép" trong 1,5s làm phản hồi trực quan.
    private string? copiedField;

    public async Task ShowAsync()
    {
        copiedField = null;
        await modal.ShowAsync();
    }

    public async Task HideAsync()
    {
        await modal.HideAsync();
    }

    private async Task Close()
    {
        await HideAsync();
        await OnClose.InvokeAsync();
    }

    private Task CopyMessageAsync() =>
        CopyFieldAsync(Log?.Message ?? string.Empty, FieldMessage);

    private Task CopyExceptionAsync() =>
        CopyFieldAsync(Log?.Exception ?? string.Empty, FieldException);

    // Copy bản Properties đã format (khớp nội dung đang hiển thị) thay vì XML thô.
    private Task CopyPropertiesAsync() =>
        CopyFieldAsync(FormatProperties(Log?.Properties), FieldProperties);

    private async Task CopyFieldAsync(string text, string fieldKey)
    {
        if (string.IsNullOrEmpty(text))
        {
            return;
        }

        try
        {
            await JS.InvokeVoidAsync("hgsCopyToClipboard", text);
            copiedField = fieldKey;
            StateHasChanged();
            await Task.Delay(1500);
            if (copiedField == fieldKey)
            {
                copiedField = null;
                StateHasChanged();
            }
        }
        catch (Exception ex)
        {
            Console.WriteLine($"Clipboard error: {ex.Message}");
        }
    }

    // Properties do sink ghi dang XML — can le dep de doc hon khi tra cuu.
    private static string FormatProperties(string? xml)
    {
        if (string.IsNullOrEmpty(xml))
            return string.Empty;

        try
        {
            var doc = System.Xml.Linq.XDocument.Parse(xml);
            return doc.ToString();
        }
        catch
        {
            return xml;
        }
    }

    private static BadgeColor GetLevelBadgeColor(string? level)
    {
        return level switch
        {
            "Fatal" => BadgeColor.Danger,
            "Error" => BadgeColor.Warning,
            _ => BadgeColor.Secondary
        };
    }
}
