@using Hgs.Share.Responses.AuditLogs
@using BlazorBootstrap
@using global::System.Text.Json

<Modal @ref="modal" Title="Chi tiết nhật ký hoạt động" OnClose="Close" Size="ModalSize.Large">
    <BodyTemplate>
        @if (AuditLog != null)
        {
            <div class="row">
                <div class="col-md-6 mb-3">
                    <label class="form-label fw-bold">ID</label>
                    <div>@AuditLog.Id</div>
                </div>
                <div class="col-md-6 mb-3">
                    <label class="form-label fw-bold">Người dùng</label>
                    <div>@(AuditLog.Username ?? "N/A")</div>
                </div>
                <div class="col-md-6 mb-3">
                    <label class="form-label fw-bold">Hành động</label>
                    <div>
                        <Badge Color="@(GetActionBadgeColor(AuditLog.Action))">@AuditLog.Action</Badge>
                    </div>
                </div>
                <div class="col-md-6 mb-3">
                    <label class="form-label fw-bold">Đối tượng</label>
                    <div>@AuditLog.EntityName</div>
                </div>
                <div class="col-md-6 mb-3">
                    <label class="form-label fw-bold">Mã đối tượng</label>
                    <div>@(AuditLog.EntityId?.ToString() ?? "N/A")</div>
                </div>
                <div class="col-md-6 mb-3">
                    <label class="form-label fw-bold">Địa chỉ IP</label>
                    <div>@(AuditLog.IpAddress ?? "N/A")</div>
                </div>
                <div class="col-12 mb-3">
                    <label class="form-label fw-bold">Thời gian</label>
                    <div>@AuditLog.CreatedAt.ToString("yyyy-MM-dd HH:mm:ss")</div>
                </div>
                @if (!string.IsNullOrEmpty(AuditLog.OldValue))
                {
                    <div class="col-12 mb-3">
                        <label class="form-label fw-bold">Giá trị cũ</label>
                        <pre class="bg-light p-3 rounded" style="max-height: 300px; overflow-y: auto;">@FormatJson(AuditLog.OldValue)</pre>
                    </div>
                }
                @if (!string.IsNullOrEmpty(AuditLog.NewValue))
                {
                    <div class="col-12 mb-3">
                        <label class="form-label fw-bold">Giá trị mới</label>
                        <pre class="bg-light p-3 rounded" style="max-height: 300px; overflow-y: auto;">@FormatJson(AuditLog.NewValue)</pre>
                    </div>
                }
            </div>
        }
    </BodyTemplate>
    <FooterTemplate>
        <Button Color="ButtonColor.Secondary" @onclick="OnClose">Đóng</Button>
    </FooterTemplate>
</Modal>

@code {
    private Modal modal = default!;
    [Parameter] public AuditLogsGetAllResponse? AuditLog { get; set; }
    [Parameter] public EventCallback OnClose { get; set; }

    public async Task ShowAsync()
    {
        await modal.ShowAsync();
    }

    public async Task HideAsync()
    {
        await modal.HideAsync();
    }

    private async Task Close()
    {
        await HideAsync();
        await OnClose.InvokeAsync();
    }

    private string FormatJson(string? json)
    {
        if (string.IsNullOrEmpty(json))
            return string.Empty;

        try
        {
            using var document = JsonDocument.Parse(json);
            return JsonSerializer.Serialize(document, new JsonSerializerOptions { WriteIndented = true });
        }
        catch
        {
            return json;
        }
    }

    private BadgeColor GetActionBadgeColor(string action)
    {
        return action switch
        {
            "CREATE" => BadgeColor.Success,
            "UPDATE" => BadgeColor.Warning,
            "DELETE" => BadgeColor.Danger,
            _ => BadgeColor.Secondary
        };
    }
}
