@page "/audit"
@namespace WebApp.Client.Pages.SystemPages.Audit
@using Hgs.Share.Responses.AuditLogs
@using BlazorBootstrap

<PageTitle>Nhật ký hoạt động</PageTitle>

<div class="container">
    <div class="row">
        <div class="col-12">
            <div class="d-flex justify-content-between align-items-center mb-4">
                <h1 class="h2 mb-0">Nhật ký hoạt động</h1>
            </div>

            <Card>
                <CardBody>
                    @if (isLoading)
                    {
                        <div class="text-center py-5">
                            <Spinner Color="SpinnerColor.Primary" />
                        </div>
                    }
                    else if (errorMessage != null)
                    {
                        <HgsErrorState Message="@errorMessage" RetryClick="@LoadAuditLogs" />
                    }
                    else if (auditLogs != null && !auditLogs.Any())
                    {
                        <HgsEmptyState Title="Chưa có nhật ký hoạt động"
                                       Message="Các sự kiện sẽ xuất hiện tại đây khi được ghi lại." />
                    }
                    else
                    {
                        <Grid TItem="AuditLogsGetAllResponse" Data="auditLogs" AllowPaging="true" AllowSorting="true" Responsive="true"
                              Class="table table-hover table-bordered table-striped" PageSize="@pageSize" TotalItems="@totalCount">
                            <GridColumn TItem="AuditLogsGetAllResponse" HeaderText="ID" SortKeyExpression="item => item.Id">
                                @context.Id
                            </GridColumn>
                            <GridColumn TItem="AuditLogsGetAllResponse" HeaderText="Người dùng" SortKeyExpression="item => item.Username">
                                @(context.Username ?? "N/A")
                            </GridColumn>
                            <GridColumn TItem="AuditLogsGetAllResponse" HeaderText="Hành động" SortKeyExpression="item => item.Action">
                                <Badge Color="@(GetActionBadgeColor(context.Action))">@context.Action</Badge>
                            </GridColumn>
                            <GridColumn TItem="AuditLogsGetAllResponse" HeaderText="Đối tượng" SortKeyExpression="item => item.EntityName">
                                @context.EntityName
                            </GridColumn>
                            <GridColumn TItem="AuditLogsGetAllResponse" HeaderText="Mã đối tượng" SortKeyExpression="item => item.EntityId">
                                @(context.EntityId?.ToString() ?? "N/A")
                            </GridColumn>
                            <GridColumn TItem="AuditLogsGetAllResponse" HeaderText="Địa chỉ IP" SortKeyExpression="item => item.IpAddress">
                                @(context.IpAddress ?? "N/A")
                            </GridColumn>
                            <GridColumn TItem="AuditLogsGetAllResponse" HeaderText="Thời gian" SortKeyExpression="item => item.CreatedAt">
                                @context.CreatedAt.ToString("yyyy-MM-dd HH:mm:ss")
                            </GridColumn>
                            <GridColumn TItem="AuditLogsGetAllResponse" HeaderText="Thao tác" AllowSorting="false">
                                <Button Color="ButtonColor.Info" Outline="true" Size="ButtonSize.Small" @onclick="() => ShowDetailModal(context)" aria-label="Xem chi tiết nhật ký">
                                    <Icon Name="IconName.Eye" />
                                </Button>
                            </GridColumn>
                        </Grid>
                    }
                </CardBody>
            </Card>
        </div>
    </div>
</div>

<AuditDetailModal @ref="auditDetailModal"
    AuditLog="selectedAuditLog"
    OnClose="CloseDetailModal" />
