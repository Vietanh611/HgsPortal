@using Hgs.Share.Requests.Roles
@using Hgs.Share.Responses.OrganizationUnits
@using BlazorBootstrap

<Modal @ref="modal" Title="@(IsEditMode ? "Sửa vai trò" : "Thêm vai trò")" OnClose="Close" Size="ModalSize.Large">
    <BodyTemplate>
        <EditForm Model="@RoleForm" OnValidSubmit="HandleSubmit">
            <DataAnnotationsValidator />
            
            <div class="row g-3">
                <div class="col-md-6">
                    <label class="form-label">Mã</label>
                    <InputText class="form-control" @bind-Value="RoleForm.Code" />
                    <ValidationMessage For="() => RoleForm.Code" class="text-danger" />
                </div>

                <div class="col-md-6">
                    <label class="form-label">Tên</label>
                    <InputText class="form-control" @bind-Value="RoleForm.Name" />
                    <ValidationMessage For="() => RoleForm.Name" class="text-danger" />
                </div>

                <div class="col-12">
                    <label class="form-label">Mô tả</label>
                    <InputTextArea class="form-control" @bind-Value="RoleForm.Description" rows="2" />
                </div>

                <div class="col-md-6">
                    <label class="form-label">Đơn vị</label>
                    <InputSelect class="form-select" @bind-Value="RoleForm.OrganizationUnitId">
                        <option value="">-- Chọn đơn vị --</option>
                        @if (OrganizationUnits != null)
                        {
                            @foreach (var ou in OrganizationUnits)
                            {
                                <option value="@ou.Id">@ou.Name</option>
                            }
                        }
                    </InputSelect>
                </div>

                <div class="col-md-6">
                    <label class="form-label">Phạm vi dữ liệu</label>
                    <InputSelect class="form-select" @bind-Value="RoleForm.DataScope">
                        <option value="Self">Cá nhân</option>
                        <option value="Department">Phòng ban</option>
                        <option value="Organization">Đơn vị</option>
                        <option value="All">Toàn bộ</option>
                    </InputSelect>
                </div>

                <div class="col-md-6">
                    <div class="form-check">
                        <InputCheckbox class="form-check-input" id="isSystemRole" @bind-Value="RoleForm.IsSystemRole" />
                        <label class="form-check-label" for="isSystemRole">Vai trò hệ thống</label>
                    </div>
                </div>

                <div class="col-md-6">
                    <div class="form-check">
                        <InputCheckbox class="form-check-input" id="isActive" @bind-Value="RoleForm.IsActive" />
                        <label class="form-check-label" for="isActive">Hoạt động</label>
                    </div>
                </div>
            </div>
        </EditForm>
    </BodyTemplate>
    <FooterTemplate>
        <Button Color="ButtonColor.Secondary" @onclick="OnClose" Disabled="@IsSubmitting">Hủy</Button>
        <Button Color="ButtonColor.Primary" @onclick="HandleSubmit" Disabled="@IsSubmitting">
            @if (IsSubmitting)
            {
                <Spinner Color="SpinnerColor.Light" Size="SpinnerSize.Small" class="me-2" />
            }
            Lưu
        </Button>
    </FooterTemplate>
</Modal>

@code {
    private Modal modal = default!;
    [Parameter] public RolesCreateRequest RoleForm { get; set; } = new();
    [Parameter] public IEnumerable<OrganizationUnitsGetAllResponse>? OrganizationUnits { get; set; }
    [Parameter] public bool IsEditMode { get; set; }
    [Parameter] public bool IsSubmitting { get; set; }
    [Parameter] public EventCallback OnClose { get; set; }
    [Parameter] public EventCallback OnSubmit { get; set; }

    public async Task ShowAsync()
    {
        await modal.ShowAsync();
    }

    public async Task HideAsync()
    {
        await modal.HideAsync();
    }

    private async Task HandleSubmit()
    {
        await OnSubmit.InvokeAsync();
    }

    private async Task Close()
    {
        await HideAsync();
        await OnClose.InvokeAsync();
    }
}
