@page "/users"
@inherits AuthorizedPageBase
@using Hgs.Share.Responses.Users
@using BlazorBootstrap
@inject NavigationManager Navigation


<PageTitle>Quản lý người dùng</PageTitle>

<div class="container">
    <div class="row">
        <div class="col-12">
            <div class="d-flex flex-wrap justify-content-between align-items-center gap-2 mb-2">
                <h1 class="h2 mb-0">Quản lý người dùng</h1>
                <Button Color="ButtonColor.Primary" @onclick="ShowCreateModal" Class="text-nowrap">
                    <Icon Name="IconName.PlusLg" /> Thêm người dùng
                </Button>
            </div>

            @if (isLoading)
            {
                <div class="text-center py-5">
                    <Spinner Color="SpinnerColor.Primary" />
                </div>
            }
            else if (errorMessage != null)
            {
                <HgsErrorState Message="@errorMessage" RetryClick="@LoadUsers" />
            }
            else if (users != null && !users.Any())
            {
                <HgsEmptyState Title="Chưa có người dùng"
                               Message="Nhấn Thêm người dùng để tạo người dùng đầu tiên."
                               ShowAction="true"
                               ActionText="Thêm người dùng"
                               ActionClick="@ShowCreateModal" />
            }
            else
            {
                <Grid TItem="UsersGetAllResponse" Data="users" AllowPaging="true" AllowSorting="true" PageSize="10" Responsive="true"
                      Class="table table-hover table-bordered table-striped">
                    <GridColumn TItem="UsersGetAllResponse" HeaderText="Ảnh đại diện" AllowSorting="false" Width="70px">
                        @if (!string.IsNullOrWhiteSpace(context.AvatarUrl))
                        {
                            <img src="@context.AvatarUrl"
                                 alt="Ảnh đại diện của @context.Username"
                                 class="rounded-circle object-fit-cover"
                                 style="width: 36px; height: 36px;" />
                        }
                        else
                        {
                            <span class="avatar-circle" style="width: 36px; height: 36px;">@(context.FullName?.Substring(0, 1).ToUpper() ?? context.Username?.Substring(0, 1).ToUpper() ?? "U")</span>
                        }
                    </GridColumn>
                    <GridColumn TItem="UsersGetAllResponse" HeaderText="Tên đăng nhập" SortKeySelector="item => item.Username">
                        @context.Username
                    </GridColumn>
                    <GridColumn TItem="UsersGetAllResponse" HeaderText="Email" SortKeySelector="item => item.Email">
                        @context.Email
                    </GridColumn>
                    <GridColumn TItem="UsersGetAllResponse" HeaderText="Họ tên" SortKeySelector="item => item.FullName">
                        @context.FullName
                    </GridColumn>
                    <GridColumn TItem="UsersGetAllResponse" HeaderText="Điện thoại" SortKeySelector="item => item.PhoneNumber">
                        @context.PhoneNumber
                    </GridColumn>
                    <GridColumn TItem="UsersGetAllResponse" HeaderText="Bravo ID" SortKeySelector="item => item.BravoId">
                        @(context.BravoId?.ToString() ?? "N/A")
                    </GridColumn>
                    <GridColumn TItem="UsersGetAllResponse" HeaderText="Đơn vị" SortKeySelector="item => item.OrganizationUnitName">
                        @(context.OrganizationUnitName ?? "N/A")
                    </GridColumn>
                    <GridColumn TItem="UsersGetAllResponse" HeaderText="Trạng thái">
                        @if (context.IsActive)
                        {
                            <Badge Color="BadgeColor.Success">Hoạt động</Badge>
                        }
                        else
                        {
                            <Badge Color="BadgeColor.Secondary">Ngừng hoạt động</Badge>
                        }
                        @if (context.IsLocked)
                        {
                            <Badge Color="BadgeColor.Danger" class="ms-1">Đã khóa</Badge>
                        }
                    </GridColumn>
                    <GridColumn TItem="UsersGetAllResponse" HeaderText="Đăng nhập gần nhất" SortKeyExpression="item => item.LastLoginAt">
                        @(context.LastLoginAt?.ToLocalTime().ToString("dd/MM/yyyy HH:mm") ?? "Chưa đăng nhập")
                    </GridColumn>
                    <GridColumn TItem="UsersGetAllResponse" HeaderText="Thao tác" AllowSorting="false">
                        <Button Color="ButtonColor.Primary" Outline="true" Size="ButtonSize.Small" @onclick="() => ShowEditModal(context)" class="me-1" aria-label="Sửa người dùng">
                            <Icon Name="IconName.Pencil" />
                        </Button>
                        <Button Color="ButtonColor.Warning" Size="ButtonSize.Small" @onclick="() => ShowResetPasswordModal(context)" class="me-1" aria-label="Đặt lại mật khẩu">
                            <Icon Name="IconName.KeyFill" />
                        </Button>
                        @if (context.IsLocked)
                        {
                            <Button Color="ButtonColor.Success" Outline="true" Size="ButtonSize.Small" @onclick="() => UnlockUser(context)" class="me-1" aria-label="Mở khóa tài khoản">
                                <Icon Name="IconName.Unlock" />
                            </Button>
                        }
                        <Button Color="ButtonColor.Success" Outline="true" Size="ButtonSize.Small" @onclick="() => ShowAssignRoleModal(context)" class="me-1" aria-label="Gán vai trò">
                            <Icon Name="IconName.Shield" />
                        </Button>
                        <Button Color="ButtonColor.Info" Outline="true" Size="ButtonSize.Small" @onclick="() => ShowAssignMenuModal(context)" class="me-1" aria-label="Gán menu">
                            <Icon Name="IconName.ListCheck" />
                        </Button>
                        <Button Color="ButtonColor.Danger" Outline="true" Size="ButtonSize.Small" @onclick="() => DeleteUser(context.Id)" aria-label="Xóa người dùng">
                            <Icon Name="IconName.Trash" />
                        </Button>
                    </GridColumn>
                </Grid>
            }
        </div>
    </div>
</div>

<UserFormModal @ref="userFormModal"
    UserForm="userForm"
    OrganizationUnits="organizationUnits"
    IsEditMode="isEditMode"
    IsSubmitting="isSubmitting"
    OnClose="CloseUserFormModal"
    OnSubmit="HandleSubmit" />

<ResetPasswordModal @ref="resetPasswordModal"
    ResetPasswordForm="resetPasswordForm"
    Username="@resetPasswordUsername"
    IsResettingPassword="isResettingPassword"
    OnClose="CloseResetPasswordModal"
    OnSubmit="HandleResetPassword" />

<AssignMenuModal @ref="assignMenuModal"
    Username="@assignMenuUsername"
    OnClose="CloseAssignMenuModal"
    Menus="menus"
    SelectedMenuIds="selectedMenuIds"
    RoleMenuIds="roleMenuIds"
    ExpandedMenuIds="expandedMenuIds"
    IsLoadingMenus="isLoadingMenus"
    IsAssigningMenus="isAssigningMenus"
    OnMenuCheckboxChanged="(args) => HandleMenuCheckboxChanged(args.Item1, args.Item2)"
    ToggleMenu="(menuId) => HandleToggleMenu(menuId)"
    OnSubmit="HandleAssignMenus" />

<AssignRoleModal @ref="assignRoleModal"
    Username="@assignRoleUsername"
    OnClose="CloseAssignRoleModal"
    Roles="roles"
    SelectedRoleIds="selectedRoleIds"
    IsLoadingRoles="isLoadingRoles"
    IsAssigningRoles="isAssigningRoles"
    OnRoleCheckboxChanged="HandleRoleCheckboxChanged"
    OnSubmit="HandleAssignRoles" />
