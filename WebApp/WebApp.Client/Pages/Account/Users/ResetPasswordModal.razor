@using Hgs.Share.Requests.Users
@using BlazorBootstrap

<Modal @ref="modal" Title="@($"Đặt lại mật khẩu - {Username}")" OnClose="Close" Size="ModalSize.Large">
    <BodyTemplate>
        <EditForm Model="@ResetPasswordForm" OnValidSubmit="HandleSubmit">
            <DataAnnotationsValidator />

            <div class="row g-3">
                <div class="col-md-6">
                    <label class="form-label">Tên đăng nhập</label>
                    <input type="text" class="form-control" value="@Username" disabled />
                </div>

                <div class="col-md-6">
                    <label class="form-label">Mật khẩu mới</label>
                    <InputText @bind-Value="ResetPasswordForm.NewPassword" class="form-control" type="password" autocomplete="new-password" />
                    <ValidationMessage For="() => ResetPasswordForm.NewPassword" class="text-danger" />
                </div>

                <div class="col-md-6">
                    <label class="form-label">Xác nhận mật khẩu</label>
                    <InputText @bind-Value="ResetPasswordForm.ConfirmPassword" class="form-control" type="password" autocomplete="new-password" />
                    <ValidationMessage For="() => ResetPasswordForm.ConfirmPassword" class="text-danger" />
                </div>
            </div>

            <div class="alert alert-warning mt-3 mb-0">
                Người dùng sẽ được đặt mật khẩu mới mà không cần mật khẩu cũ.
            </div>
        </EditForm>
    </BodyTemplate>
    <FooterTemplate>
        <Button Color="ButtonColor.Secondary" @onclick="Close">Hủy</Button>
        <Button Color="ButtonColor.Primary" @onclick="HandleSubmit" Disabled="@IsResettingPassword">
            @if (IsResettingPassword)
            {
                <Spinner Color="SpinnerColor.Light" Size="SpinnerSize.Small" class="me-2" />
            }
            Đặt lại mật khẩu
        </Button>
    </FooterTemplate>
</Modal>

@code {
    private Modal modal = default!;
    [Parameter]
    public UsersResetPasswordRequest ResetPasswordForm { get; set; } = new();

    [Parameter]
    public string Username { get; set; } = string.Empty;

    [Parameter]
    public bool IsResettingPassword { get; set; }

    [Parameter]
    public EventCallback OnClose { get; set; }

    [Parameter]
    public EventCallback OnSubmit { get; set; }

    public async Task ShowAsync()
    {
        await modal.ShowAsync();
    }

    public async Task HideAsync()
    {
        await modal.HideAsync();
    }

    private async Task HandleSubmit()
    {
        await OnSubmit.InvokeAsync();
    }

    private async Task Close()
    {
        await HideAsync();
        await OnClose.InvokeAsync();
    }
}