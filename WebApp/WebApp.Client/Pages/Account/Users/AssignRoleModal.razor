@using Hgs.Share.Responses.Roles
@using BlazorBootstrap

<Modal @ref="modal" Title="@($"Assign Roles - {Username}")" OnClose="OnClose" Size="ModalSize.Large">
    <BodyTemplate>
        @if (IsLoadingRoles)
        {
            <div class="text-center">
                <Spinner Color="SpinnerColor.Primary" />
            </div>
        }
        else
        {
            <div class="list-group">
                @if (Roles == null || !Roles.Any())
                {
                    <div class="text-center text-muted">No roles available</div>
                }
                else
                {
                    @foreach (var role in Roles)
                    {
                        var isSelected = SelectedRoleIds.Contains(role.Id);
                        <div class="list-group-item">
                            <div class="form-check">
                                <input class="form-check-input" type="checkbox"
                                       id="role-@role.Id"
                                       value="@role.Id"
                                       checked="@isSelected"
                                       @onchange="@(e => OnRoleCheckboxChanged(role.Id, e.Value?.ToString()))" />
                                <label class="form-check-label" for="role-@role.Id">
                                    <strong>@role.Name</strong> (@role.Code)
                                    @if (role.IsSystemRole)
                                    {
                                        <Badge Color="BadgeColor.Info" class="ms-2">System</Badge>
                                    }
                                    @if (!role.IsActive)
                                    {
                                        <Badge Color="BadgeColor.Secondary" class="ms-2">Inactive</Badge>
                                    }
                                </label>
                            </div>
                            @if (!string.IsNullOrEmpty(role.Description))
                            {
                                <small class="text-muted d-block ms-4">@role.Description</small>
                            }
                            <small class="text-muted d-block ms-4">Data Scope: @role.DataScope</small>
                        </div>
                    }
                }
            </div>
        }
    </BodyTemplate>
    <FooterTemplate>
        <Button Color="ButtonColor.Secondary" @onclick="OnClose" Disabled="@IsAssigningRoles">Close</Button>
        <Button Color="ButtonColor.Primary" @onclick="OnSubmit" Disabled="@IsAssigningRoles">
            @if (IsAssigningRoles)
            {
                <Spinner Color="SpinnerColor.Light" Size="SpinnerSize.Small" class="me-2" />
            }
            Save
        </Button>
    </FooterTemplate>
</Modal>

@code {
    private Modal modal = default!;
    [Parameter] public bool IsVisible { get; set; }
    [Parameter] public string Username { get; set; } = string.Empty;
    [Parameter] public IEnumerable<RolesGetAllResponse>? Roles { get; set; }
    [Parameter] public List<int> SelectedRoleIds { get; set; } = new();
    [Parameter] public bool IsLoadingRoles { get; set; }
    [Parameter] public bool IsAssigningRoles { get; set; }
    [Parameter] public EventCallback OnClose { get; set; }
    [Parameter] public EventCallback OnSubmit { get; set; }
    [Parameter] public Action<int, string?> OnRoleCheckboxChanged { get; set; } = default!;

    public async Task ShowAsync()
    {
        await modal.ShowAsync();
    }
    public async Task HideAsync()
    {
        await modal.HideAsync();
    }
}
