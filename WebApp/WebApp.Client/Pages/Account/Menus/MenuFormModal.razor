@using Hgs.Share.Requests.Menus
@using BlazorBootstrap

<Modal @ref="modal" Title="@(IsEditMode ? "Sửa menu" : "Thêm menu")" OnClose="Close" Size="ModalSize.Large">
    <BodyTemplate>
        <EditForm Model="@MenuForm" OnValidSubmit="HandleSubmit">
            <DataAnnotationsValidator />
            
            <div class="row g-3">
                <div class="col-md-6">
                    <label class="form-label">Mã</label>
                    <InputText class="form-control" @bind-Value="MenuForm.Code" />
                    <ValidationMessage For="() => MenuForm.Code" class="text-danger" />
                </div>

                <div class="col-md-6">
                    <label class="form-label">Tên</label>
                    <InputText class="form-control" @bind-Value="MenuForm.Name" />
                    <ValidationMessage For="() => MenuForm.Name" class="text-danger" />
                </div>

                <div class="col-md-6">
                    <label class="form-label">Menu cha</label>
                    <InputSelect class="form-select" @bind-Value="MenuForm.ParentId">
                        <option value="">-- Menu gốc --</option>
                        @if (ParentMenus != null)
                        {
                            @foreach (var parent in ParentMenus)
                            {
                                <option value="@parent.Id">@parent.Name</option>
                            }
                        }
                    </InputSelect>
                </div>

                <div class="col-md-6">
                    <label class="form-label">Đường dẫn</label>
                    <InputText class="form-control" @bind-Value="MenuForm.Route" placeholder="/duong-dan" />
                </div>

                <div class="col-md-6">
                    <label class="form-label">Thành phần</label>
                    <InputText class="form-control" @bind-Value="MenuForm.Component" placeholder="TenThanhPhan" />
                </div>

                <div class="col-md-6">
                    <label class="form-label">Biểu tượng</label>
                    <InputText class="form-control" @bind-Value="MenuForm.Icon" placeholder="bi-icon-name" />
                </div>

                <div class="col-md-6">
                    <label class="form-label">Thứ tự</label>
                    <InputNumber class="form-control" @bind-Value="MenuForm.SortOrder" />
                </div>

                <div class="col-md-6 d-flex align-items-center">
                    <div class="form-check mb-0">
                        <InputCheckbox class="form-check-input" id="isVisible" @bind-Value="MenuForm.IsVisible" />
                        <label class="form-check-label" for="isVisible">Hiển thị</label>
                    </div>
                </div>

                <div class="col-md-6 d-flex align-items-center">
                    <div class="form-check mb-0">
                        <InputCheckbox class="form-check-input" id="isActive" @bind-Value="MenuForm.IsActive" />
                        <label class="form-check-label" for="isActive">Hoạt động</label>
                    </div>
                </div>
            </div>
        </EditForm>
    </BodyTemplate>
    <FooterTemplate>
        <Button Color="ButtonColor.Secondary" @onclick="OnClose" Disabled="@IsSubmitting">Hủy</Button>
        <Button Color="ButtonColor.Primary" @onclick="HandleSubmit" Disabled="@IsSubmitting">
            @if (IsSubmitting)
            {
                <Spinner Color="SpinnerColor.Light" Size="SpinnerSize.Small" class="me-2" />
            }
            Lưu
        </Button>
    </FooterTemplate>
</Modal>

@code {
    private Modal modal = default!;
    [Parameter] public MenusCreateRequest MenuForm { get; set; } = new();
    [Parameter] public IEnumerable<Hgs.Share.Responses.Menus.MenusGetAllResponse>? ParentMenus { get; set; }
    [Parameter] public bool IsEditMode { get; set; }
    [Parameter] public bool IsSubmitting { get; set; }
    [Parameter] public EventCallback OnClose { get; set; }
    [Parameter] public EventCallback OnSubmit { get; set; }

    public async Task ShowAsync()
    {
        await modal.ShowAsync();
    }

    public async Task HideAsync()
    {
        await modal.HideAsync();
    }

    private async Task HandleSubmit()
    {
        await OnSubmit.InvokeAsync();
    }

    private async Task Close()
    {
        await HideAsync();
        await OnClose.InvokeAsync();
    }
}
