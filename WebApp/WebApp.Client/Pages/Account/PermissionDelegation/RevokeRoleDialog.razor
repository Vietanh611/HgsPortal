@using Hgs.Share.Responses.PermissionDelegation
@using BlazorBootstrap

<Modal @ref="modal" Title="@ModalTitle" OnClose="Close">
    <BodyTemplate>
        @if (UserRoles == null || !UserRoles.Any())
        {
            <Alert Color="AlertColor.Info">Người dùng chưa có quyền nào</Alert>
        }
        else
        {
            <div class="mb-3">
                <label class="form-label">Chọn quyền để gỡ:</label>
                <select class="form-select" @onchange="HandleRoleSelected">
                    <option value="">-- Chọn quyền --</option>
                    @foreach (var role in UserRoles)
                    {
                        <option value="@role.Id">@role.Name</option>
                    }
                </select>
            </div>
        }
    </BodyTemplate>
    <FooterTemplate>
        <Button Color="ButtonColor.Secondary" @onclick="Close">Hủy</Button>
        <Button Color="ButtonColor.Warning" @onclick="HandleSubmit" Disabled="@string.IsNullOrEmpty(selectedRoleId)">
            Gỡ quyền
        </Button>
    </FooterTemplate>
</Modal>

@code {
    private Modal modal = default!;
    [Parameter] public int TargetUserId { get; set; }
    [Parameter] public string TargetUsername { get; set; } = string.Empty;
    [Parameter] public List<RoleInfo> UserRoles { get; set; } = new();
    [Parameter] public EventCallback OnClose { get; set; }
    [Parameter] public EventCallback<int> OnSubmit { get; set; }

    private string? selectedRoleId;
    private string ModalTitle => $"Gỡ quyền của {TargetUsername}";

    public async Task ShowAsync()
    {
        selectedRoleId = null;
        await modal.ShowAsync();
    }

    public async Task HideAsync()
    {
        await modal.HideAsync();
    }

    private void HandleRoleSelected(ChangeEventArgs e)
    {
        selectedRoleId = e.Value?.ToString();
    }

    private async Task Close()
    {
        await HideAsync();
        selectedRoleId = null;
        await OnClose.InvokeAsync();
    }

    private async Task HandleSubmit()
    {
        if (int.TryParse(selectedRoleId, out var roleId))
        {
            await OnSubmit.InvokeAsync(roleId);
            await HideAsync();
            selectedRoleId = null;
        }
    }
}
