@page "/permission-delegation"
@inherits AuthorizedPageBase
@using Hgs.Share.Responses.PermissionDelegation
@using BlazorBootstrap

<PageTitle>Quản lý phân quyền</PageTitle>

<div class="container">
    <div class="row">
        <div class="col-12">
            <div class="d-flex justify-content-between align-items-center mb-2">
                <h1 class="h2 mb-0">Quản lý phân quyền</h1>
            </div>

            @if (isLoading)
            {
                <div class="text-center py-5">
                    <Spinner Color="SpinnerColor.Primary" />
                </div>
            }
            else if (errorMessage != null)
            {
                <HgsErrorState Message="@errorMessage" RetryClick="@LoadManageableUsers" />
            }
            else if (!manageableUsers.Any())
            {
                <HgsEmptyState Title="Không có nhân viên trong phạm vi quản lý"
                               Message="Không có nhân viên nào trong phạm vi quản lý của bạn." />
            }
            else
            {
                <Grid TItem="ManageableUserResponse" Data="manageableUsers" AllowPaging="true" AllowSorting="true" Responsive="true"
                      Class="table table-hover table-bordered table-striped" PageSize="10">
                    <GridColumn TItem="ManageableUserResponse" HeaderText="Tên đăng nhập" SortKeyExpression="item => item.Username">
                        @context.Username
                    </GridColumn>
                    <GridColumn TItem="ManageableUserResponse" HeaderText="Email" SortKeyExpression="item => item.Email">
                        @context.Email
                    </GridColumn>
                    <GridColumn TItem="ManageableUserResponse" HeaderText="Họ tên" SortKeyExpression="item => item.FullName">
                        @context.FullName
                    </GridColumn>
                    <GridColumn TItem="ManageableUserResponse" HeaderText="Đơn vị" SortKeyExpression="item => item.OrganizationUnitName">
                        @(context.OrganizationUnitName ?? "N/A")
                    </GridColumn>
                    <GridColumn TItem="ManageableUserResponse" HeaderText="Trạng thái">
                        @if (context.IsActive)
                        {
                            <Badge Color="BadgeColor.Success">Hoạt động</Badge>
                        }
                        else
                        {
                            <Badge Color="BadgeColor.Secondary">Ngừng hoạt động</Badge>
                        }
                    </GridColumn>
                    <GridColumn TItem="ManageableUserResponse" HeaderText="Thao tác" AllowSorting="false">
                        <Button Color="ButtonColor.Info" Outline="true" Size="ButtonSize.Small" @onclick="async () => await ShowAssignPermissionModal(context)" aria-label="Xem/phân quyền">
                            <Icon Name="IconName.Eye" />
                        </Button>
                    </GridColumn>
                </Grid>
            }
        </div>
    </div>
</div>

<AssignPermissionModal @ref="assignPermissionModal" @key="nameof(AssignPermissionModal)"
    TargetUsername="@selectedUsername"
    AssignableRoles="assignableRoles"
    UserRoles="userRoles"
    UserMenus="userMenus"
    SelectedRoleIds="selectedRoleIds"
    IsLoading="isLoadingPermissions"
    IsSaving="isSavingPermissions"
    OnRoleCheckboxChanged="OnPermissionCheckboxChanged"
    OnClose="CloseAssignPermissionModal"
    OnSubmit="HandleAssignPermissions" />