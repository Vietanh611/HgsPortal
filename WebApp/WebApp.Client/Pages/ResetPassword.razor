@page "/reset-password/{Token}"
@using Microsoft.AspNetCore.Components.Forms
@using WebApp.Client.Services.Network

@layout EmptyLayout
@inject ApiClient ApiClient
@inject NavigationManager Navigation

<PageTitle>Reset Password</PageTitle>

<div class="reset-container">
    <Card Class="reset-card">
        <CardBody Class="text-center">
            <img src="@logoPath" alt="HGS Logo" class="reset-logo" />
            <h1 class="reset-title">Reset Password</h1>
            <p class="reset-subtitle">Enter your new password below.</p>
        </CardBody>
        <CardBody>
            @if (!done)
            {
                <EditForm Model="@form" OnValidSubmit="HandleSubmit">
                    <DataAnnotationsValidator />
                    <div class="mb-3">
                        <label class="form-label">New Password</label>
                        <InputText type="password" @bind-Value="form.NewPassword" class="form-control" placeholder="Enter new password" />
                        <ValidationMessage For="() => form.NewPassword" />
                    </div>
                    <div class="mb-3">
                        <label class="form-label">Confirm Password</label>
                        <InputText type="password" @bind-Value="confirmPassword" class="form-control" placeholder="Re-enter new password" />
                        @if (!string.IsNullOrEmpty(confirmPassword) && confirmPassword != form.NewPassword)
                        {
                            <div class="text-danger small">Passwords do not match.</div>
                        }
                    </div>
                    @if (!string.IsNullOrEmpty(errorMessage))
                    {
                        <Alert Color="AlertColor.Danger" Class="mb-3">@errorMessage</Alert>
                    }
                    <Button Type="ButtonType.Submit" Color="ButtonColor.Primary" Class="w-100" Disabled="@isLoading">
                        @if (isLoading)
                        {
                            <Spinner Color="SpinnerColor.Light" Size="SpinnerSize.Small" class="me-2" />
                        }
                        Reset Password
                    </Button>
                </EditForm>
            }
            else
            {
                <Alert Color="AlertColor.Success">
                    Your password has been reset successfully.
                </Alert>
                <Button Color="ButtonColor.Primary" Class="w-100" @onclick="GoToLogin">
                    Back to Login
                </Button>
            }
        </CardBody>
    </Card>
</div>

<style>
    .reset-container {
        display: flex;
        justify-content: center;
        align-items: center;
        min-height: 100vh;
        background: linear-gradient(135deg, var(--hgs-blue) 0%, var(--hgs-blue-dark) 100%);
        padding: 1rem;
    }

    .reset-card {
        width: 100%;
        max-width: 400px;
    }

    .reset-logo {
        width: 120px;
        height: auto;
        margin: 0 auto;
        display: block;
        margin-bottom: 1rem;
    }

    .reset-title {
        color: var(--hgs-blue);
        font-size: 1.5rem;
        margin-bottom: 0.5rem;
        font-weight: 700;
    }

    .reset-subtitle {
        color: var(--text-secondary);
        font-size: 0.95rem;
        margin: 0;
    }
</style>

@code {
    [Parameter] public string? Token { get; set; }

    private ResetPasswordRequest form = new();
    private string? confirmPassword;
    private string? errorMessage;
    private bool isLoading;
    private bool done;

    private string logoPath => $"{Navigation.BaseUri}assets/hgs/new%20logo/logo.png";

    protected override void OnInitialized()
    {
        form.Token = Token ?? string.Empty;
    }

    private void GoToLogin() => Navigation.NavigateTo("login");

    private async Task HandleSubmit()
    {
        if (string.IsNullOrEmpty(confirmPassword) || confirmPassword != form.NewPassword)
        {
            errorMessage = "Passwords do not match.";
            return;
        }

        isLoading = true;
        errorMessage = null;

        try
        {
            var response = await ApiClient.PostAsync<ApiResponse>("auth/reset-password", form);
            done = true;
        }
        catch (Exception ex)
        {
            errorMessage = "Unable to reset your password. Please try again later.";
            Console.WriteLine($"Reset password error: {ex.Message}");
        }
        finally
        {
            isLoading = false;
        }
    }
}