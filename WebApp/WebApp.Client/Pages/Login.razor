@page "/login"
@using WebApp.Client.Layout
@layout EmptyLayout
@inject HttpClient Http
@inject NavigationManager Navigation
@inject IJSRuntime JS

<PageTitle>Login</PageTitle>

<div class="login-container">
    <Card Class="login-card">
        <CardBody Class="text-center login-header">
            <h1>HGS Portal</h1>
            <p>Sign in to your account</p>
        </CardBody>
        <CardBody>
            <EditForm Model="@loginRequest" OnValidSubmit="HandleLogin">
                <DataAnnotationsValidator />

                <div class="mb-3">
                    <label class="form-label">Username</label>
                    <InputText @bind-Value="loginRequest.Username" class="form-control" placeholder="Enter your username" />
                    <ValidationMessage For="() => loginRequest.Username" class="error-message" />
                </div>

                <div class="mb-3">
                    <label class="form-label">Password</label>
                    <InputText type="password" @bind-Value="loginRequest.Password" class="form-control" placeholder="Enter your password" />
                    <ValidationMessage For="() => loginRequest.Password" class="error-message" />
                </div>

                @if (!string.IsNullOrEmpty(errorMessage))
                {
                    <Alert Color="AlertColor.Danger" Class="mb-3">
                        @errorMessage
                    </Alert>
                }

                <Button Type="ButtonType.Submit" Color="ButtonColor.Primary" Class="w-100" Disabled="@isLoading">
                    @if (isLoading)
                    {
                        <Spinner Color="SpinnerColor.Light" Size="SpinnerSize.Small" class="me-2" />
                    }
                    Sign In
                </Button>
            </EditForm>
        </CardBody>
        <CardFooter Class="text-center login-footer">
            <p>Don't have an account? <a href="/register">Register</a></p>
        </CardFooter>
    </Card>
</div>

<style>
    .login-container {
        display: flex;
        justify-content: center;
        align-items: center;
        min-height: 100vh;
        background: linear-gradient(135deg, var(--hgs-blue) 0%, var(--hgs-blue-dark) 100%);
        padding: 1rem;
    }

    .login-card {
        width: 100%;
        max-width: 400px;
    }

    .login-header {
        margin-bottom: 1.5rem;
    }

    .login-header h1 {
        color: var(--hgs-blue);
        font-size: 2rem;
        margin-bottom: 0.5rem;
        font-weight: 700;
    }

    .login-header p {
        color: var(--text-secondary);
        font-size: 0.95rem;
        margin: 0;
    }

    .error-message {
        color: #e53e3e;
        font-size: 0.85rem;
        margin-top: 0.25rem;
    }

    .login-footer {
        margin-top: 1rem;
        padding-top: 1rem;
        border-top: 1px solid var(--border);
    }

    .login-footer p {
        color: var(--text-secondary);
        font-size: 0.9rem;
        margin: 0;
    }

    .login-footer a {
        color: var(--hgs-blue);
        text-decoration: none;
        font-weight: 500;
    }

    .login-footer a:hover {
        text-decoration: underline;
    }
</style>

@code {
    private AuthenticateRequest loginRequest = new();
    private string errorMessage = string.Empty;
    private bool isLoading = false;

    private async Task HandleLogin()
    {
        isLoading = true;
        errorMessage = string.Empty;

        try
        {
            var response = await Http.PostAsJsonAsync("auth/login", loginRequest);
            
            if (response.IsSuccessStatusCode)
            {
                var apiResponse = await response.Content.ReadFromJsonAsync<ApiResponse<AuthenticateResponse>>();
                
                if (apiResponse != null && apiResponse.Success && apiResponse.Data != null)
                {
                    // Store tokens in localStorage using JS interop
                    await JS.InvokeVoidAsync("localStorage.setItem", "accessToken", apiResponse.Data.AccessToken);
                    await JS.InvokeVoidAsync("localStorage.setItem", "refreshToken", apiResponse.Data.RefreshToken);
                    await JS.InvokeVoidAsync("localStorage.setItem", "expiresAt", apiResponse.Data.ExpiresAt.ToString());
                    
                    // Navigate to home page
                    Navigation.NavigateTo("/");
                }
                else
                {
                    errorMessage = apiResponse?.Message ?? "Login failed";
                }
            }
            else
            {
                var errorContent = await response.Content.ReadAsStringAsync();
                errorMessage = $"Login failed: {response.StatusCode}";
            }
        }
        catch (Exception ex)
        {
            errorMessage = $"An error occurred: {ex.Message}";
        }
        finally
        {
            isLoading = false;
        }
    }
}
