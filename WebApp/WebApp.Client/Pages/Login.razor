@page "/"
@page "/login"
@using Microsoft.AspNetCore.Components.Forms
@using WebApp.Client.Services.Auth

@layout EmptyLayout
@inject CustomAuthenticationStateProvider AuthStateProvider
@inject NavigationManager Navigation
@inject IJSRuntime JS

@code {
    private string logoPath => $"{Navigation.BaseUri}assets/hgs/new%20logo/logo.png";

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (firstRender)
        {
            // Check if user is already authenticated
            // var authState = await AuthStateProvider.GetAuthenticationStateAsync();
            // if (authState.User.Identity?.IsAuthenticated == true)
            // {
            //     Navigation.NavigateTo("home", forceLoad: true);
            // }
            
            await LoadRememberedCredentials();
        }
    }

    private async Task LoadRememberedCredentials()
    {
        if (hasLoadedCredentials) return;
        
        hasLoadedCredentials = true;
        // Load saved username
        var savedUsername = await JS.InvokeAsync<string>("localStorage.getItem", "rememberedUsername");
        if (!string.IsNullOrEmpty(savedUsername))
        {
            loginRequest.Username = savedUsername;
        }
        
        // Load Remember Me preference
        var savedRememberMe = await JS.InvokeAsync<string>("localStorage.getItem", "rememberMe");
        if (!string.IsNullOrEmpty(savedRememberMe))
        {
            rememberMe = bool.Parse(savedRememberMe);
        }
        
        StateHasChanged();
    }
}

<PageTitle>Login</PageTitle>

<div class="login-container">
    <Card Class="login-card">
        <CardBody Class="text-center">
            <img src="@logoPath" alt="HGS Logo" class="login-logo" />
        </CardBody>
        <CardBody>
            <EditForm Model="@loginRequest" OnValidSubmit="HandleLogin">
                <DataAnnotationsValidator />

                @* <div class="mb-3">
                    <label class="form-label">Username</label>
                    <InputText @bind-Value="loginRequest.Username" class="form-control" placeholder="Enter your username" />
                    <ValidationMessage For="() => loginRequest.Username" class="error-message" />
                </div>

                <div class="mb-3">
                    <label class="form-label">Password</label>
                    <InputText type="password" @bind-Value="loginRequest.Password" class="form-control" placeholder="Enter your password" />
                    <ValidationMessage For="() => loginRequest.Password" class="error-message" />
                </div> *@
                <div class="mb-3">
                    <label class="form-label">Username</label>

                    <div class="input-group">
                        <span class="input-group-text">
                            <i class="bi bi-person"></i>
                        </span>

                        <InputText @bind-Value="loginRequest.Username"
                                   class="form-control"
                                   placeholder="Enter your username" />
                    </div>

                    <ValidationMessage For="() => loginRequest.Username" />
                </div>

                <div class="mb-3">
                    <label class="form-label">Password</label>
                    <div class="input-group">
                        <span class="input-group-text">
                            <i class="bi bi-lock"></i>
                        </span>
                        <InputText type="@(showPassword ? "text" : "password")"
                                   class="form-control"
                                   @bind-Value="loginRequest.Password"
                                   placeholder="Enter your password" />
                        <span class="input-group-text" role="button" @onclick="() => showPassword = !showPassword">
                            <i class="bi @(showPassword ? "bi-eye-slash" : "bi-eye")"></i>
                        </span>
                    </div>
                    <ValidationMessage For="() => loginRequest.Password" />
                </div>

                <div class="mb-3 form-check">
                    <InputCheckbox @bind-Value="rememberMe" class="form-check-input" id="rememberMe" />
                    <label class="form-check-label" for="rememberMe">Remember Me</label>
                </div>

                @if (!string.IsNullOrEmpty(errorMessage))
                {
                    <Alert Color="AlertColor.Danger" Class="mb-3">
                        @errorMessage
                    </Alert>
                }

                <Button Type="ButtonType.Submit" Color="ButtonColor.Primary" Class="w-100" Disabled="@isLoading">
                    @if (isLoading)
                    {
                        <Spinner Color="SpinnerColor.Light" Size="SpinnerSize.Small" class="me-2" />
                    }
                    Sign In
                </Button>
            </EditForm>
        </CardBody>
        <CardFooter Class="text-center login-footer">
            <a href="forgot-password">Forgot Password?</a>
        </CardFooter>
    </Card>
</div>

<style>
    .login-container {
        display: flex;
        justify-content: center;
        align-items: center;
        min-height: 100vh;
        background: linear-gradient(135deg, var(--hgs-blue) 0%, var(--hgs-blue-dark) 100%);
        padding: 1rem;
    }

    .login-card {
        width: 100%;
        max-width: 400px;
    }

    .login-header {
        margin-bottom: 1.5rem;
    }

    .login-logo {
        width: 120px;
        height: auto;
        margin: 0 auto;
        display: block;
    }

    .login-header h1 {
        color: var(--hgs-blue);
        font-size: 2rem;
        margin-bottom: 0.5rem;
        font-weight: 700;
    }

    .login-header p {
        color: var(--text-secondary);
        font-size: 0.95rem;
        margin: 0;
    }

    .error-message {
        color: #e53e3e;
        font-size: 0.85rem;
        margin-top: 0.25rem;
    }

    .login-footer {
        margin-top: 1rem;
        padding-top: 1rem;
        border-top: 1px solid var(--border);
    }

    .login-footer p {
        color: var(--text-secondary);
        font-size: 0.9rem;
        margin: 0;
    }

    .login-footer a {
        color: var(--hgs-blue);
        text-decoration: none;
        font-weight: 500;
    }

    .login-footer a:hover {
        text-decoration: underline;
    }
</style>

@code {
    private AuthenticateRequest loginRequest = new();
    private string errorMessage = string.Empty;
    private bool isLoading = false;
    private bool showPassword = false;
    private bool rememberMe = false;
    private bool hasLoadedCredentials = false;


    private async Task HandleLogin()
    {
        isLoading = true;
        errorMessage = string.Empty;

        try
        {
            var loginResult = await AuthStateProvider.LoginAsync(loginRequest.Username, loginRequest.Password);

            if (loginResult == null)
            {
                errorMessage = "Invalid username or password.";
                return;
            }

            var authState = await AuthStateProvider.GetAuthenticationStateAsync();
            if (authState.User.Identity?.IsAuthenticated != true)
            {
                errorMessage = "Login succeeded but authentication state is not ready yet. Please try again.";
                return;
            }

            // Handle Remember Me
            if (rememberMe)
            {
                await JS.InvokeVoidAsync("localStorage.setItem", "rememberedUsername", loginRequest.Username);
                await JS.InvokeVoidAsync("localStorage.setItem", "rememberMe", "true");
            }
            else
            {
                await JS.InvokeVoidAsync("localStorage.removeItem", "rememberedUsername");
                await JS.InvokeVoidAsync("localStorage.removeItem", "rememberMe");
            }

            // Navigate to home page
            Navigation.NavigateTo("/home", forceLoad: true);
        }
        catch (Exception ex)
        {
            errorMessage = $"An error occurred: {ex.Message}";
        }
        finally
        {
            isLoading = false;
        }
    }
}
