@page "/forgot-password"
@using Microsoft.AspNetCore.Components.Forms
@using WebApp.Client.Services.Network

@layout EmptyLayout
@inject ApiClient ApiClient
@inject NavigationManager Navigation

<PageTitle>Forgot Password</PageTitle>

<div class="forgot-container">
    <Card Class="forgot-card">
        <CardBody Class="text-center">
            <img src="@logoPath" alt="HGS Logo" class="forgot-logo" />
            <h1 class="forgot-title">Forgot Password</h1>
            <p class="forgot-subtitle">Enter your email and we'll send you a link to reset your password.</p>
        </CardBody>
        <CardBody>
            @if (!sent)
            {
                <EditForm Model="@form" OnValidSubmit="HandleSubmit">
                    <DataAnnotationsValidator />
                    <div class="mb-3">
                        <label class="form-label">Email</label>
                        <InputText @bind-Value="form.Email" type="email" class="form-control" placeholder="Enter your email" />
                        <ValidationMessage For="() => form.Email" />
                    </div>
                    @if (!string.IsNullOrEmpty(errorMessage))
                    {
                        <Alert Color="AlertColor.Danger" Class="mb-3">@errorMessage</Alert>
                    }
                    <Button Type="ButtonType.Submit" Color="ButtonColor.Primary" Class="w-100" Disabled="@isLoading">
                        @if (isLoading)
                        {
                            <Spinner Color="SpinnerColor.Light" Size="SpinnerSize.Small" class="me-2" />
                        }
                        Send Reset Link
                    </Button>
                </EditForm>
            }
            else
            {
                <Alert Color="AlertColor.Success">
                    Liên kết đặt lại mật khẩu đã được gửi đến email của bạn. Vui lòng kiểm tra hộp thư đến và làm theo hướng dẫn.
                </Alert>
                <Button Color="ButtonColor.Secondary" Class="w-100" @onclick="GoToLogin">
                    Back to Login
                </Button>
            }
        </CardBody>
    </Card>
</div>

<style>
    .forgot-container {
        display: flex;
        justify-content: center;
        align-items: center;
        min-height: 100vh;
        background: linear-gradient(135deg, var(--hgs-blue) 0%, var(--hgs-blue-dark) 100%);
        padding: 1rem;
    }

    .forgot-card {
        width: 100%;
        max-width: 400px;
    }

    .forgot-logo {
        width: 120px;
        height: auto;
        margin: 0 auto;
        display: block;
        margin-bottom: 1rem;
    }

    .forgot-title {
        color: var(--hgs-blue);
        font-size: 1.5rem;
        margin-bottom: 0.5rem;
        font-weight: 700;
    }

    .forgot-subtitle {
        color: var(--text-secondary);
        font-size: 0.95rem;
        margin: 0;
    }
</style>

@code {
    private ForgotPasswordRequest form = new();
    private string? errorMessage;
    private bool isLoading;
    private bool sent;

    private string logoPath => $"{Navigation.BaseUri}assets/hgs/new%20logo/logo.png";

    private void GoToLogin() => Navigation.NavigateTo("login");

    private async Task HandleSubmit()
    {
        if (string.IsNullOrWhiteSpace(form.Email) || !form.Email.Contains('@'))
        {
            errorMessage = "Please enter a valid email address.";
            return;
        }

        isLoading = true;
        errorMessage = null;

        try
        {
            var response = await ApiClient.PostAsync<ApiResponse>("auth/forgot-password", form);
            sent = true;
        }
        catch (Exception ex)
        {
            errorMessage = "Unable to process your request. Please try again later.";
            Console.WriteLine($"Forgot password error: {ex.Message}");
        }
        finally
        {
            isLoading = false;
        }
    }
}