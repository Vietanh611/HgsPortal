@inherits LayoutComponentBase
@implements IAsyncDisposable
@using WebApp.Client.Services
@using WebApp.Client.Services.Auth
@using WebApp.Client.Services.Data
@using WebApp.Client.Services.Network
@using WebApp.Client.Services.Components
@using BlazorBootstrap
@using Hgs.Share.Responses.ApiResponses
@using Hgs.Share.Responses.Menus
@using Microsoft.AspNetCore.Components.Authorization
@inject DialogService DialogService
@inject ITokenStorage TokenStorage
@inject IMenuCacheService MenuCacheService
@inject JwtTokenService JwtService
@inject NavigationManager Navigation
@inject IServiceProvider ServiceProvider
@inject AuthService AuthService
@inject AuthenticationStateProvider AuthenticationStateProvider

<CascadingAuthenticationState>
    <div class="bb-page">
        <Sidebar @ref="sidebar"
                 DataProvider="SidebarDataProvider"
                 ImageSrc="@($"{Navigation.BaseUri}assets/hgs/new%20logo/logoWhite.png")"
                 Title="HGS PORTAL"
                 IsResponsive="true" />

        <main>
            <article class="content px-1">
                @Body
            </article>
        </main>
    </div>
</CascadingAuthenticationState>

@code {
    private readonly TaskCompletionSource<bool> _menuLoaded =
        new(TaskCreationOptions.RunContinuationsAsynchronously);

    List<MenusGetByUserIdResponse> userMenus = new();
    Sidebar? sidebar;
    private bool _isLoadingMenus = false;
    private int? _lastUserId;

    protected override async Task OnInitializedAsync()
    {
        // Subscribe to authentication state changes
        AuthenticationStateProvider.AuthenticationStateChanged += OnAuthenticationStateChanged;

        try
        {
            var refreshed = await AuthService.RefreshAccessTokenAsync();
            if (!refreshed)
            {
                await TokenStorage.ClearTokensAsync();
                userMenus = new List<MenusGetByUserIdResponse>();
                _menuLoaded.TrySetResult(true);
                return;
            }

            await LoadUserMenus();
        }
        catch (Exception ex)
        {

            userMenus = new List<MenusGetByUserIdResponse>();
        }
        finally
        {
            _menuLoaded.TrySetResult(true);
        }
    }

    private async void OnAuthenticationStateChanged(Task<AuthenticationState> task)
    {
        try
        {
            var authState = await task;

            if (authState.User.Identity?.IsAuthenticated == true)
            {
                // Avoid duplicate API call if we're already loading menus
                if (!_isLoadingMenus)
                {
                    await LoadUserMenus();
                }
            }
            else
            {
                userMenus = new List<MenusGetByUserIdResponse>();
                var lastUserId = _lastUserId;
                _lastUserId = null;
                await MenuCacheService.ClearCachedMenusAsync(lastUserId);
                StateHasChanged();
            }
        }
        catch (Exception ex)
        {
            Console.WriteLine($"Error handling authentication state change: {ex.Message}");
        }
    }

    public async ValueTask DisposeAsync()
    {
        AuthenticationStateProvider.AuthenticationStateChanged -= OnAuthenticationStateChanged;
    }

    private async Task LoadUserMenus()
    {
        if (_isLoadingMenus)
        {
            return;
        }

        _isLoadingMenus = true;

        try
        {
            var token = await TokenStorage.GetAccessTokenAsync();
            if (string.IsNullOrWhiteSpace(token))
            {
                userMenus = new List<MenusGetByUserIdResponse>();
                return;
            }

            var userId = JwtService.ExtractUserId(token);
            if (!userId.HasValue)
            {
                userMenus = new List<MenusGetByUserIdResponse>();
                return;
            }

            _lastUserId = userId;

            // Try to get cached menus for this user first
            var cachedMenus = await MenuCacheService.GetCachedMenusAsync(userId.Value);
            if (cachedMenus != null && cachedMenus.Any())
            {
                userMenus = cachedMenus;
                StateHasChanged();
                return;
            }

            // Skip API calls during server-side prerendering
            var apiClient = ServiceProvider.GetService<ApiClient>();
            if (apiClient == null)
            {
                userMenus = new List<MenusGetByUserIdResponse>();
                return;
            }

            var response = await apiClient.GetAsync<ApiResponse<IEnumerable<MenusGetByUserIdResponse>>>("api/my-menus");
            if (response != null && response.Success && response.Data != null)
            {
                userMenus = response.Data.ToList();
                // Cache the menus for future use
                await MenuCacheService.SetCachedMenusAsync(userId.Value, userMenus);
            }
            else
            {
                userMenus = new List<MenusGetByUserIdResponse>();
                userMenus = new List<MenusGetByUserIdResponse>();
            }
        }
        catch (Exception ex)
        {
            Console.WriteLine($"Error loading user menus: {ex.Message}");
            userMenus = new List<MenusGetByUserIdResponse>();
        }
        finally
        {
            _isLoadingMenus = false;
        }
    }

    private async Task<SidebarDataProviderResult> SidebarDataProvider(SidebarDataProviderRequest request)
    {
        await _menuLoaded.Task;
        var items = GetNavItems().ToList();

        return request.ApplyTo(items);
    }

    private IEnumerable<NavItem> GetNavItems()
    {
        var items = new List<NavItem>();

        // Dynamic menu based on user permissions from API
        if (userMenus.Any())
        {
            // Build menu tree from API data (API already returns hierarchical structure)
            foreach (var menu in userMenus.Where(m => m.ParentId == null && m.IsVisible && m.IsActive))
            {
                var navItem = CreateNavItem(menu);
                items.Add(navItem);

                // Add children recursively if has children
                if (menu.Children != null && menu.Children.Any() && !string.IsNullOrEmpty(navItem.Id))
                {
                    AddChildMenus(items, menu, navItem.Id);
                }
            }
        }

        // Logout at the bottom of the sidebar
        items.Add(new NavItem
        {
            Id = "logout",
            Href = "logout",
            IconName = IconName.BoxArrowRight,
            Text = "Đăng xuất"
        });

        return items;
    }

    private NavItem CreateNavItem(MenusGetByUserIdResponse menu)
    {
        var route = !string.IsNullOrEmpty(menu.Route) ? menu.Route.TrimStart('/') : "#";
        return new NavItem
        {
            Id = menu.Id.ToString(),
            Href = route,
            IconName = !string.IsNullOrEmpty(menu.Icon) && Enum.TryParse<IconName>(menu.Icon, out var iconName) ? iconName : IconName.Circle,
            Text = menu.Name
        };
    }

    private void AddChildMenus(List<NavItem> items, MenusGetByUserIdResponse parentMenu, string parentId)
    {
        foreach (var child in parentMenu.Children.Where(c => c.IsVisible && c.IsActive))
        {
            var navItem = CreateNavItem(child);
            navItem.ParentId = parentId;
            items.Add(navItem);

            // Recursive for nested children
            if (!string.IsNullOrEmpty(navItem.Id))
            {
                AddChildMenus(items, child, navItem.Id);
            }
        }
    }

    private ConfirmDialog? confirmDialog;

    protected override void OnAfterRender(bool firstRender)
    {
        if (firstRender && confirmDialog != null)
        {
            DialogService.SetConfirmDialog(confirmDialog);
        }
    }
}

