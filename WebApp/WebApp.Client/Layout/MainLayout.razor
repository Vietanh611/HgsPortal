    <style>
        :root {
            /* Sidebar */
            --bb-sidebar-width: 270px;
            --bb-sidebar-collapsed-width: 60px;
            /* Background */
            --bb-sidebar-background-color: #17479E;
            --bb-sidebar-top-row-background-color: #123A82;
            --bb-sidebar-content-border-color: rgba(255,255,255,.15);
            /* Brand */
            --bb-sidebar-title-text-color: #FFFFFF;
            --bb-sidebar-brand-icon-color: #F58220;
            --bb-sidebar-brand-image-width: 28px;
            --bb-sidebar-brand-image-height: 28px;
            /* Badge */
            --bb-sidebar-title-badge-text-color: #FFFFFF;
            --bb-sidebar-title-badge-background-color: #F58220;
            /* Toggle */
            --bb-sidebar-navbar-toggler-icon-color: #FFFFFF;
            --bb-sidebar-navbar-toggler-background-color: rgba(255,255,255,.1);
            /* Menu */
            --bb-sidebar-nav-item-text-color: rgba(255,255,255,.85);
            --bb-sidebar-nav-item-text-hover-color: #FFFFFF;
            --bb-sidebar-nav-item-text-active-color: #FFFFFF;
            /* Active / Hover */
        --bb-sidebar-nav-item-background-hover-color: #F58220;
            --bb-sidebar-nav-item-group-background-color: rgba(255,255,255,.08);
            /* Border */
            --bb-sidebar-top-row-border-color: rgba(255,255,255,.15);
        }

        .bb-top-row {
            background: #ffffff;
            border-bottom: 1px solid #D6E4F5;
        }

        .content {
            background: #F8F9FA;
            min-height: 100vh;
        }
    </style>

