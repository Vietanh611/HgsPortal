@inject IConfiguration Configuration
@inject NavigationManager Navigation
@inject IWebHostEnvironment Environment

@{
    var basePath = Configuration["BasePath"] ?? "/";
    var isDevelopment = Environment.IsDevelopment();
}

<!DOCTYPE html>
<html lang="vi">

<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <base href="@basePath" />

<link rel="stylesheet" href="lib/bootstrap/dist/css/bootstrap.min.css" />
    <link rel="stylesheet" href="lib/bootstrap-icons/font/bootstrap-icons.css" />
    <link href="_content/Blazor.Bootstrap/blazor.bootstrap.css" rel="stylesheet" />
    <link rel="stylesheet" href="css/hgsStyle.css" />
    <link rel="stylesheet" href="WebApp.styles.css" />
    <meta name="theme-color" content="#17479E" />

    <HeadOutlet @rendermode="InteractiveWebAssembly" />
</head>

<body>
    <Routes @rendermode="InteractiveWebAssembly" />

    <script src="lib/bootstrap/dist/js/bootstrap.bundle.min.js"></script>
    <script src="_framework/blazor.web.js"></script>
    <script src="_content/Blazor.Bootstrap/blazor.bootstrap.js"></script>

    <script>
        // Tự focus vào ô nhập đầu tiên khi mở modal (a11y)
        document.addEventListener('shown.bs.modal', function (event) {
            var firstField = event.target.querySelector('input:not([type="hidden"]):not([disabled]), select:not([disabled]), textarea:not([disabled])');
            if (firstField) {
                firstField.focus();
            }
        });
    </script>

    <script>
        // Tải file nhị phân (export) qua blob — cần qua HttpClient để mang Bearer token
        window.hgsDownloadFile = function (fileName, byteArray) {
            var blob = new Blob([byteArray], { type: 'application/vnd.openxmlformats-officedocument.spreadsheetml.sheet' });
            var url = URL.createObjectURL(blob);
            var a = document.createElement('a');
            a.href = url;
            a.download = fileName;
            document.body.appendChild(a);
            a.click();
            document.body.removeChild(a);
            URL.revokeObjectURL(url);
        };
        // Tải file text cấu hình thiết bị (kiosk provisioning)
        window.hgsDownloadTextFile = function (fileName, content) {
            var blob = new Blob([content], { type: 'text/plain;charset=utf-8' });
            var url = URL.createObjectURL(blob);
            var a = document.createElement('a');
            a.href = url;
            a.download = fileName;
            document.body.appendChild(a);
            a.click();
            document.body.removeChild(a);
            URL.revokeObjectURL(url);
        };
        // Copy text vào clipboard (dùng cho deviceIdentifier/pairingCode)
        window.hgsCopyToClipboard = function (text) {
            return navigator.clipboard.writeText(text);
        };
    </script>

    <!-- Chart.js (dùng cho chart components) -->
    <script src="https://cdnjs.cloudflare.com/ajax/libs/Chart.js/4.0.1/chart.umd.js" integrity="sha512-gQhCDsnnnUfaRzD8k1L5llCCV6O9HN09zClIzzeJ8OJ9MpGmIlCxm+pdCkqTwqJ4JcjbojFr79rl2F1mzcoLMQ==" crossorigin="anonymous" referrerpolicy="no-referrer"></script>
    <!-- chartjs-plugin-datalabels (cho chart data labels) -->
    <script src="https://cdnjs.cloudflare.com/ajax/libs/chartjs-plugin-datalabels/2.2.0/chartjs-plugin-datalabels.min.js" integrity="sha512-JPcRR8yFa8mmCsfrw4TNte1ZvF1e3+1SdGMslZvmrzDYxS69J7J49vkFL8u6u8PlPJK+H3voElBtUCzaXj+6ig==" crossorigin="anonymous" referrerpolicy="no-referrer"></script>
    <!-- sortable.js (cho SortableList) -->
    <script src="https://cdn.jsdelivr.net/npm/sortablejs@latest/Sortable.min.js"></script>

    <script>
        // Load the appropriate manifest based on current URL
        function loadManifest() {
            const basePath = '@(Configuration["BasePath"] ?? "/")';
            const currentPath = window.location.pathname;
            let manifestHref = null;

            if (currentPath.startsWith(basePath + 'display/DomesticBaggageArrivalDisplay')) {
                manifestHref = basePath + 'pwa/domestic-arrival.webmanifest';
            } else if (currentPath.startsWith(basePath + 'display/InternationalBaggageArrivalDisplay')) {
                manifestHref = basePath + 'pwa/international-arrival.webmanifest';
            } else {
                manifestHref = basePath + 'manifest.webmanifest';
            }

            let link = document.querySelector('link[rel="manifest"]');
            if (!link) {
                link = document.createElement('link');
                link.rel = 'manifest';
                document.head.appendChild(link);
            }
            link.href = manifestHref;
        }

        if (document.readyState === 'loading') {
            document.addEventListener('DOMContentLoaded', loadManifest);
        } else {
            loadManifest();
        }

        function isPwaMode() {
            return window.matchMedia('(display-mode: standalone)').matches
                || window.matchMedia('(display-mode: minimal-ui)').matches
                || window.matchMedia('(display-mode: fullscreen)').matches
                || (window.navigator.standalone === true);
        }

        function unregisterServiceWorkers() {
            navigator.serviceWorker.getRegistrations().then(function(registrations) {
                registrations.forEach(function(registration) {
                    registration.unregister();
                });
            }).catch(function() { });
        }

        if ('serviceWorker' in navigator) {
            var basePath = '@(Configuration["BasePath"] ?? "/")';

            if (@(isDevelopment.ToString().ToLower())) {
                unregisterServiceWorkers();
            } else if (isPwaMode()) {
                navigator.serviceWorker.register(basePath + 'service-worker.js', { scope: basePath })
                    .catch(function() { });
            } else {
                unregisterServiceWorkers();
            }
        }
    </script>
</body>

</html>